include "hardware.inc"
include "banker.rgbinc"
include "sprite.rgbinc"


;; Maximum number of sprite instances
def SPRITE_POOL_CAPACITY equ 20
;; Size of sprite pool in bytes
def SPRITE_POOL_SIZE equ SPRITE_POOL_CAPACITY * szSpriteInst


pushs "wSpritePool", wramx, align[8]
wSpritePoolMeta: ds SPRITE_POOL_CAPACITY
wSpritePool: ds SPRITE_POOL_SIZE

pops ; wSpritePool


pushs "SpritePoolInit", rom0
SpritePoolInit::
		wrambpush bank(wSpritePool)
	ld a, SpriteInst_DEFAULT
	ld bc, SPRITE_POOL_SIZE
	ld hl, wSpritePool
	call MemFillLarge

	ld a, SpritePoolSlot_EMPTY
	ld c, SPRITE_POOL_CAPACITY
	ld hl, wSpritePoolMeta
	call MemFillSmall
		wrambpop
	ret

pops ; SpritePoolInit


pushs "SpritePoolAlloc", rom0
;; Find and allocate a (contiguous) block of empty sprite pool slots.
;; @param B: Number of slots required
;; @ret HL: pointer to empty slot SpriteInst
;; @ret F.C: success
;; @mut AF, BC, HL
SpritePoolAlloc::
	ld a, b
	and a
	ret z

		wrambpush bank(wSpritePool)
	ld hl, wSpritePoolMeta + SPRITE_POOL_CAPACITY
	ld c, SPRITE_POOL_CAPACITY
	; contiguous empty slots count
	ld a, b
.loop
	dec hl ; started at end (excl.) so decrement before access
	bit bSpritePoolSlot_EMPTY, [hl]
	jr nz, :+
	; reset counter
	ld a, b
	jr .continue
:
	; decrement counter, if reach zero: success
	dec a
	jr z, .found
.continue
	dec c
	jr nz, .loop
	; failed
		wrambpop ; wSpritePool
	and a ; return F.NC
	ret

.found
	dec c ; index at start of block

	; mark slots as occupied
:
	res bSpritePoolSlot_EMPTY, [hl]
	inc hl
	dec b
	jr nz, :-

	; calculate address of first allocated
	assert szSpriteInst == 16
	assert low(wSpritePoolMeta) == 0 ; meta array is aligned: address low byte == index.
	; index * 16
	ld l, c :: ld h, 0
	rept 4
		add hl, hl
	endr
	; ... + wSpritePool
	ld bc, wSpritePool
	add hl, bc

		wrambpop ; wSpritePool
	scf ; return F.C
	ret

pops ; SpritePoolAlloc


pushs "SpritePoolUpdate", rom0
SpritePoolUpdate::
		rombpush
		wrambpush bank(wSpritePool)

	ld bc, wSpritePoolMeta
	ld hl, wSpritePool
	ld de, szSpriteInst
.loop:
	ld a, [bc]
	bit bSpritePoolSlot_EMPTY, a
	jr nz, .continue

		push bc :: push hl

	; TODO: do something with flags?
	ld a, [hl+] ; .flags

	; Y
	ld a, [wScroll.y + 0] :: ld c, a
	ld a, [wScroll.y + 1] :: ld b, a
	ld a, [hl+] :: sub c :: ld c, a
	ld a, [hl+] :: sbc b :: ld b, a

	; X
	ld a, [wScroll.x + 0] :: ld e, a
	ld a, [wScroll.x + 1] :: ld d, a
	ld a, [hl+] :: sub e :: ld e, a
	ld a, [hl+] :: sbc d :: ld d, a

	call SprxTestVisibility
	jr nc, .continue_pop

	; set render position
	ld a, b :: ldh [hObModY], a
	ld a, c :: ldh [hObModX], a
	; chri
	ld a, [hl+] :: ldh [hObModChri], a
	; atrb
	ld a, [hl+] :: ldh [hObModAtrb], a

	ld d, 1
	call AniUpdate
		rombsel b ; select bank of ani frame drawable
	call SprxRenderMod_ObMod

.continue_pop:
		pop hl :: pop bc
	ld de, szSpriteInst
.continue:
	inc bc
	add hl, de
	assert low(wSpritePoolMeta) + SPRITE_POOL_CAPACITY < 256
	ld a, c
	cp SPRITE_POOL_CAPACITY
	jr c, .loop

		wrambpop
		rombpop

	ret

pops ; SpritePoolUpdate

