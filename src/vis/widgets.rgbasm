include "widgets.rgbinc"
include "hardware.inc"
include "banker.rgbinc"
include "chrimp.rgbinc"
include "sprite.rgbinc"


	import_chr "assets/widgets.chr", Widgets, pal, idx, atrb


pushs fragment "SpriteData", romx
def _DT equ 5
def _Y equ 0
def _X equ 0
WidgetPointer::
	.f1::
		ani_frame _DT * 40, .f2
		sprob _Y + 0, _X + 0, 0, 0
		sprob_end
	.f2:
		ani_frame _DT * 2, .f3
		sprob _Y - 2, _X - 2, 0, 0
		sprob_end
	.f3:
		ani_frame _DT * 4, .f4
		sprob _Y - 3, _X - 3, 0, 0
		sprob_end
	.f4:
		ani_frame _DT * 1, .f5
		sprob _Y - 1, _X - 1, 0, 0
		sprob_end
	.f5:
		ani_frame _DT * 2, .f1
		sprob _Y + 1, _X + 1, 0, 0
		sprob_end


redef _DT equ 2
redef _Y equ 0
redef _X equ 0
WidgetGrab::
	.f1::
		ani_frame _DT * 5, .f2
		sprob _Y - 1, _X - 1, 0, 0
		sprob_end
	.f2:
		ani_frame _DT * 2, .f3
		sprob _Y + 0, _X + 0, 1, 0
		sprob_end
	.f3:
		ani_frame _DT * 2, .f4
		sprob _Y + 0, _X + 0, 2, 0
		sprob_end
	.f4:
		ani_frame _DT * 8, .f1
		sprob _Y + 0, _X + 0, 3, 0
		sprob_end


redef _DT equ 15
redef _Y equ -4
redef _X equ -4
WidgetDeny::
	.f1::
		ani_frame _DT * 2, .f2
		sprob _Y, _X, 0, 0
		sprob_end
	.f2:
		ani_frame _DT * 1, .f1
		sprob_end


redef _DT equ 7
redef _Y equ -4
redef _X equ -4
WidgetSpin::
	.f1::
		ani_frame _DT, .f2
		sprob _Y + 0, _X + 0, 0, 0
		sprob_end
	.f2:
		ani_frame _DT, .f3
		sprob _Y + 0, _X + 0, 1, 0
		sprob_end
	.f3:
		ani_frame _DT, .f4
		sprob _Y + 0, _X + 0, 2, 0
		sprob_end
	.f4:
		ani_frame _DT, .f5
		sprob _Y + 0, _X + 0, 3, 0
		sprob_end
	.f5:
		ani_frame _DT, .f6
		sprob _Y + 0, _X + 0, 4, 0
		sprob_end
	.f6:
		ani_frame _DT, .f1
		sprob _Y + 0, _X + 0, 5, 0
		sprob_end

pops ; SpriteData

