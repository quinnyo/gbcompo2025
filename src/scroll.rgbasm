include "hardware.inc"

/*
# WTF
- move the view by setting deltas: wScroll.dy, wScroll.dx before calling ScrollUpdate
- ScrollUpdate applies the deltas and invokes map rendering
- the `SCY`/`SCX` registers are *NOT* modified
	- probably use `wScroll.y` & `wScroll.x` for this (scroll position in dots, low byte)

# Coordinate Conventions
- scrolling in world space dots
- rendering in world space grid
- convert world to bg space:
	- grid: `bg = world mod 32` or `bg = world & $1F`
	- dot: `bg = world mod 256` or `bg = world & $FF`

# Scroll Scrawl
As scroll scrolls, visible part of map changes.
The map renderer guy has to render stuff before we scroll it into view. (Who knew!)

# Front Forward
The *front* is the line of tiles just outside the view, in the direction of scrolling.
Two fronts are tracked -- one for each axis.
The front is intended to be used as a 'loading seam'.
When scrolling results in the position of a front changing, a ScrollStat flag will be set (until the next update).
*/


rsreset
;; Set to request scroll state clear and reinitialise.
export def bScrollCtl_RequestReset rb 1

export def ScrollCtl_RequestReset equ 1 << bScrollCtl_RequestReset


; X axis flags in low nybble
rsreset
; Update changed front of X axis.
export def bScrollStat_ChangeFrontX rb 1
;; Update changed chunk of X axis.
export def bScrollStat_ChangeChunkX rb 1

; Y axis flags in high nybble
rsset 4
; Update changed front of Y axis.
export def bScrollStat_ChangeFrontY rb 1
;; Update changed chunk of Y axis.
export def bScrollStat_ChangeChunkY rb 1

; Generic axis flags, to be shifted/swapped as appropriate.
def bScrollStat_ChangeFront equ bScrollStat_ChangeFrontX
def bScrollStat_ChangeChunk equ bScrollStat_ChangeChunkX


def VIEW_COLUMNS equ 20
def VIEW_ROWS equ 18
def VIEW_CHUNK_RX equ 80
def VIEW_CHUNK_RY equ 72


section "hScroll", hram
hScrollCtl:: db
hScrollStat:: db


section "wScroll", wram0
wScroll::
	;; Pending view position delta (Y axis)
	.dy:: db
	;; View scroll position in dots (Y axis)
	.y:: dw
	;; Effective delta (Y axis) from last update
	.applied_dy:: db
	;; View scroll grid row
	.row:: dw
	.y_front_dist: db
	.front_y:: db
	;; Offset to view chunk dot (Y axis)
	.chunk_point_yrel: db
	;; Map chunk in view centre (Y coord)
	.chunk_y:: dw

	;; Pending view position delta (X axis)
	.dx:: db
	;; View scroll position in dots (X axis)
	.x:: dw
	;; Effective delta (X axis) from last update
	.applied_dx:: db
	;; View scroll grid column
	.column:: dw
	.x_front_dist: db
	.front_x:: db
	;; Offset to view chunk dot (X axis)
	.chunk_point_xrel: db
	;; Map chunk in view centre (X coord)
	.chunk_x:: dw


section "Scroll", rom0
ScrollInit::
	xor a :: ldh [hScrollCtl], a
	ld a, $FF :: ldh [hScrollStat], a

	ld hl, startof("wScroll")
	ld c, sizeof("wScroll")
	xor a
	call MemFillSmall

	ld a, VIEW_ROWS + 1 :: ld [wScroll.y_front_dist], a
	ld a, VIEW_COLUMNS + 1 :: ld [wScroll.x_front_dist], a
	ld a, VIEW_CHUNK_RY :: ld [wScroll.chunk_point_yrel], a
	ld a, VIEW_CHUNK_RX :: ld [wScroll.chunk_point_xrel], a
	ret


;; @mut: AF, BC, DE, HL
ScrollUpdate::
	ldh a, [hScrollCtl]
	bit bScrollCtl_RequestReset, a
	jr nz, ScrollInit

	ld b, 0 ; B will be the new value for hScrollStat
	ld hl, wScroll.dy
	call ScrollUpdateAxis

	swap b
	ld hl, wScroll.dx
	call ScrollUpdateAxis

	ld a, b :: ldh [hScrollStat], a
	ret


;; @param HL: pointer to scroll axis state
;; @inout B: ScrollStat flags
;; @mut: AF, BC, DE, HL
ScrollUpdateAxis:
	; Load delta & clear the accumulator
	ld c, [hl]
	xor a :: ld [hl+], a

	; Get scroll position
	ld a, [hl+] :: ld e, a ; pos.0
	ld a, [hl-] :: ld d, a ; pos.1

	; If delta is zero, skip calculation
	ld a, c :: and a :: jr z, .delta_applied

	; Maybe handle upper bound
	rlca
	jr c, :+ ; if delta is negative, skip upper bound
	ld a, d :: inc a
	jr nz, :+
	; D == $FF
	sub e :: dec a :: ld c, a ; force delta = -(position + 1)
:

	inc d ; work on pos.hi + 1 to handle underflow
	; signed addition ~~ if delta < 0, dec D to emulate delta having high byte of $FF
	ld a, c :: rlca :: sbc a :: add d :: ld d, a ; dec D if delta is negative
	ld a, e :: add c :: ld e, a
	adc d :: sub e :: ld d, a
	; if D (pos.hi + 1) is zero, it underflowed. Clamp to zero.
	jr nz, :+
	ld de, $0100
:
	dec d ; undo the inc from before applying the delta, D = pos.hi

.delta_applied:
	; Calculate effective delta
	ld a, e :: sub [hl] :: ld c, a
	; Store updated position
	ld a, e :: ld [hl+], a
	ld a, d :: ld [hl+], a
	; Store effective delta
	ld a, c :: ld [hl+], a

		push de ; position

	; dot to grid
	ld a, e
	srl d :: rra
	srl d :: rra
	srl d :: rra
	ld e, a
	; store grid position
	ld a, e :: ld [hl+], a
	ld a, d :: ld [hl+], a

	; update front: add -1 if delta is negative or +FRONT offset if positive
	ld a, c :: rlca :: sbc a
	or [hl] ; front_dist
	add e
	inc hl
	cp [hl]
	jr z, :+
	set bScrollStat_ChangeFront, b
:
	ld [hl+], a

		pop de ; position

	; chunk view coord (map chunk in view centre)
	; offset to view centre
	ld a, [hl+] ; chunk_point_rel
	add e :: ld e, a
	adc d :: sub e :: ld d, a

	; div 128 via bit shift left by 7 bits
	; except impl 7 bit shift left by rotating DE left one bit and swapping D & E
	; (and masking off the low 7 bits)
	xor a ; need a zero for the result high byte
	rl e
	rl d
	ld e, d
	rla
	ld d, a

	; Compare & store chunk coord
	ld c, [hl]
	ld a, e :: ld [hl+], a
	sub c :: ld e, a
	ld c, [hl]
	ld a, d :: ld [hl+], a
	sub c :: or e
	jr z, :+
	set bScrollStat_ChangeChunk, b
:
	ret

