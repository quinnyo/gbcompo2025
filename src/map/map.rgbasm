include "map.rgbinc"
include "sprite.rgbinc"
include "hardware.inc"
include "banker.rgbinc"


def MAP_SIZE equ 32 * 32
def MAP_CHUNK_SIZE equ 16 * 16
def MAP_CHUNK_BUFFER_COUNT equ 9
def MAP_CHR_BUFFER_BANK equ 6
def MAP_ATRB_BUFFER_BANK equ 7


;; Slot status enum/flags
rsreset
;; Slot status bit range used for assigned buffer ID.
;; Buffer ID is the identifying bits of the buffer's address: `id = high(addr) - $D0`
def bSLOT_BUFFER rb 4
;; Set after the chunk in the slot has been rendered.
def bSLOT_RENDERED rb 1
;; Set if there is no chunk to render in the slot.
def bSLOT_NOCHUNK rb 1

def SLOT_BUFFER equ $0F
def SLOT_RENDERED equ 1 << bSLOT_RENDERED
def SLOT_NOCHUNK  equ 1 << bSLOT_NOCHUNK


;; Bits used to store source slot index.
def bSynXfer_SLOT_INDEX equ 0
;; Equivalent to source slot SLOT_RENDERED.
def bSynXfer_SLOT_RENDERED equ bSLOT_RENDERED
;; Equivalent to source slot SLOT_NOCHUNK.
def bSynXfer_SKIP equ bSLOT_NOCHUNK
def bSynXfer_DONE equ 6
;; Set if transfer is for a column (& needs appropriate stride applied)
def bSynXfer_ORIENTATION equ 7

def SynXfer_SLOT_INDEX equ $0F
def SynXfer_SLOT_RENDERED equ 1 << bSynXfer_SLOT_RENDERED
def SynXfer_SKIP equ 1 << bSynXfer_SKIP
def SynXfer_DONE equ 1 << bSynXfer_DONE
def SynXfer_COLUMN equ 1 << bSynXfer_ORIENTATION

def SynXfer_EMPTY equ SynXfer_SKIP


rsreset
;; Status, config, & source slot index.
def SynXfer_status rb 1
;; Transfer length (number of bytes).
def SynXfer_length rb 1
;; Starting index/offset in BG map destination.
def SynXfer_destIndex rb 2
;; Starting index/offset in source chunk.
def SynXfer_srcIndex rb 1
;;; High byte of source buffer address.
;def SynXfer_srcBuffer rb 1

;; Size of SynXfer struct.
def szSynXfer rb 0

def SYN_XFER_COUNT equ 3


/***************************************
**               MapCtl               **
***************************************/

;; Set when selected map changed / map closed.
;; Cleared when attempting to open a map.
def bMapCtl_CLEAR equ 5
;; Selected map opened successfully.
def bMapCtl_OPEN equ 6
;; Map processing enabled switch.
def bMapCtl_PROCEN equ 7

def MapCtl_CLEAR equ 1 << bMapCtl_CLEAR
def MapCtl_OPEN equ 1 << bMapCtl_OPEN
def MapCtl_PROCEN equ 1 << bMapCtl_PROCEN


section "hMapCtl", hram
hMapCtl: db


section "hMapSelect", hram
;; Bank of the selected map
hMapSelectBank: db
;; Selected map address
hMapSelectAddr: dw


section "wMapContext", wram0
;; PlayerStart Y position, in dots.
wMapPlayerStartY:: dw
;; PlayerStart X position, in dots.
wMapPlayerStartX:: dw

;; Copy of open map header
wMapHeader:: stalloc MapHeader
wMapInfo:: stalloc MapInfo


section union "wMapState", wramx[MAP_RUNTIME_STATE_ADDRESS]
wMapState:: ds MAP_RUNTIME_STATE_SIZE

;; Number of slots filled.
wMapEntitySlotsFilled:: db
;; MapEntitySlot array
wMapEntitySlots:: ds MAP_ENTITY_SLOTS_LENGTH * szMapEntitySlot


section "wMapObjectCache", wram0
;; Copy of MapObject that's being worked on.
wMapObjectCache::
	.typeid:: dw
	.y:: dw
	.x:: dw
assert @ - wMapObjectCache == szMapObject

union
wFlowRulesCache:
	; Calculated pointers to FlowRules fields.
	.vecs: dw
	.sequence: dw
	.doodads: dw
	.end: dw
nextu
endu



section "wMapChunkHeader", wram0
wMapChunkHeader:: stalloc MapChunkHeader


section "wActiveChunks", wram0
wActiveChunks:
	for Y, 3
		for X, 3
			wActiveChunk_{d:Y}_{d:X}:
				.coord_y: db
				.coord_x: db
				.origin_y: dw
				.origin_x: dw
				.header: stalloc MapChunkHeader
		endr
	endr


section "hMapRender", hram
hMapViewChunkY: db
hMapViewChunkX: db
hMapChunkSlots: ds MAP_CHUNK_BUFFER_COUNT
hMapChunkSlotsScratch: ds 3

;; The index of the next chunk slot to update
hMapSlotIdx: db


section "hMapSynXfer", hram
_destY: db
_destX: db

for I, SYN_XFER_COUNT
_Xfer{d:I}: ds szSynXfer
endr

;; For temporary storage of xfer status during xfer processing.
_xfer_status: db


section "wMapBgChr", wram0[$C800]
;; BG map CHR buffer
wMapBgChr:: ds MAP_SIZE


section "wMapBgAtrb", wramx[$D800], bank[MAP_ATRB_BUFFER_BANK]
;; BG map attribute buffer
wMapBgAtrb:: ds MAP_SIZE


for I, MAP_CHUNK_BUFFER_COUNT
	if I < 8
		def _addr equ $D000 + $100 * I
	else
		def _addr equ $D000 + $100 * I + $400
	endc

	;; Buffer ID
	def CHUNK_BUFFER_{d:I} equ high(_addr) & SLOT_BUFFER

	section "wMapBufferChr{d:I}", wramx[_addr], bank[MAP_CHR_BUFFER_BANK]
	wMapBufferChr{d:I}: ds MAP_CHUNK_SIZE

	section "wMapBufferAtrb{d:I}", wramx[_addr], bank[MAP_ATRB_BUFFER_BANK]
	wMapBufferAtrb{d:I}: ds MAP_CHUNK_SIZE

	purge _addr
endr


section "MapOpen", rom0
;; Enter/open the selected map. Flushes the cache.
;; Enables Map processing if successful.
;; @mut: AF, BC, HL
MapOpen::
	call MapReset

	ldh a, [hMapCtl]
	res bMapCtl_CLEAR, a
	ldh [hMapCtl], a

	ldh a, [hMapSelectAddr + 0] :: ld e, a
	ldh a, [hMapSelectAddr + 1] :: ld d, a
	; check for address $FFFF (no map selected)
	and e :: inc a
	ret z

	ld a, MapCtl_OPEN
	ldh [hMapCtl], a

	; Initial map setup
	ldh a, [hMapSelectBank] :: ld b, a
		rombopen b

	; Reset player start to default
	ld a, low(PLAYER_START_DEFAULT_Y) :: ld [wMapPlayerStartY + 0], a
	ld a, high(PLAYER_START_DEFAULT_Y) :: ld [wMapPlayerStartY + 1], a
	ld a, low(PLAYER_START_DEFAULT_X) :: ld [wMapPlayerStartX + 0], a
	ld a, high(PLAYER_START_DEFAULT_X) :: ld [wMapPlayerStartX + 1], a

	; Copy map header
	ld c, szMapHeader
	ld hl, wMapHeader
	call MemCopySmall

	; Copy map info
	ld hl, wMapHeader.info
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	ld c, szMapInfo
	call MemCopySmall

	; Initialise map collection
	ldh a, [hMapSelectAddr + 0] :: ld l, a
	ldh a, [hMapSelectAddr + 1] :: ld h, a
	call MapCollectionOpen

	; Process map objects
	call _SetupObjects

	; Enable processing
	ldh a, [hMapCtl]
	set bMapCtl_PROCEN, a
	ldh [hMapCtl], a
	ret


_SetupObjects:
	; NOTE: The naming of things here (MapObject, & Items in particular) does
	;     : not match up with mapconv (Elements, Resources, & Markers) and is
	;     : generally a bit confusing.
	;     : - Item is more like "(Item)Spawner"
	;     : - SpawnMapObject is more like "SpawnItem"
	ld hl, wMapHeader.resources
	ld a, [hl+]
	ld h, [hl]
	ld l, a
	ld a, [hl+] ; len
	and a
	ret z
	ld c, a
.loop
		push bc
	call _DoObject
		pop bc
	dec c
	jr nz, .loop

	ret


_DoObject:
	; Read typeid low byte and call appropriate handler function.
	ld a, [hl]
	cp MapObject_ITEM_ID_MAX
	jr c, .do_item
	cp MapObject_PLAYER_START
	jr z, .do_player_start
	cp MapObject_FLOW_RULES
	jr z, .do_flow_rules
.unknown_typeid
	ld b, b
	jr .unknown_typeid
.do_item:
	; Item Spawner
	ld b, szMapObject
	ld de, wMapObjectCache
:
	ld a, [hl+]
	ld [de], a :: inc de
	dec b
	jr nz, :-

		push hl
	ld de, wMapObjectCache
	call SpawnMapObject
		pop hl
	ret
.do_player_start:
	; Player spawn location:
	; This is just a position that gets copied for later use.
	rept MapObject_y
		inc hl
	endr
	ld a, [hl+] :: ld [wMapPlayerStartY + 0], a
	ld a, [hl+] :: ld [wMapPlayerStartY + 1], a
	ld a, [hl+] :: ld [wMapPlayerStartX + 0], a
	ld a, [hl+] :: ld [wMapPlayerStartX + 1], a
	ret
.do_flow_rules:
/* FlowRules: Defines a flow Zone effect.
	FlowRules {
		typeid: dw,
		runtime_addr: dw,
		FlowDef {
			// Set of offsets to navigate to the variable length fields.
			// `target_offset = *target - (*target_offset + 1)`
			OffsetTable {
				vecs_offset: db,
				sequence_offset: db,
				doodads_offset: db,
				end_offset: db,
			},
			vecs: { len: db, * },
			sequence: { len: db, * },
			doodads: { len: db, * },
			end: {}
		}
	}
*/
		wrambpush bank(wMapState)
	inc hl :: inc hl ; skip typeid
	; runtime state destination address
	ld a, [hl+] :: ld e, a
	ld a, [hl+] :: ld d, a
	ld bc, (MapEntityType_FLOW << 8) | MapEntityCtl_ACTIVE
	assert bank(wMapState) == bank(wMapEntitySlots)
	call MapEntitySlotInitNext.no_banking

	; Initialise FlowState
	ld a, b :: ld [de], a :: inc de ; .type
	xor a :: ld [de], a :: inc de ; .timer
	ld a, l :: ld [de], a :: inc de ; .flow_def.0
	ld a, h :: ld [de], a :: inc de ; .flow_def.1
	xor a :: ld [de], a :: inc de ; .iseq
	ld a, EffectType_FLOW :: ld [de], a :: inc de ; .effect

	; read offsets, calc target addresses, cache results
		push de
	ld d, h :: ld e, l
	ld hl, wFlowRulesCache.vecs
rept 4
	ld a, [de] :: inc de
	add e :: ld c, a :: ld [hl+], a
	adc d :: sub c :: ld [hl+], a
endr
		pop de

	; initialise flow vec / sequence
	ld hl, wFlowRulesCache.vecs
	ld a, [hl+] :: ld c, a :: ld a, [hl+] :: ld b, a ; @vecs (BC)
	ld a, [bc] :: inc bc ; vecs.len
	; TODO: check vecs.len?
	ld a, [hl+] :: ld h, [hl] :: ld l, a ; @sequence (HL)
	; get first index in sequence & index .vecs
	ld a, [hl+] ; sequence.len
	; TODO: check sequence.len?
	ld l, [hl] :: ld h, 0 ; sequence[0]
	add hl, bc
	; copy initial flow vec to FlowState
	ld a, [hl+] :: ld [de], a :: inc de ; .vx
	ld a, [hl+] :: ld [de], a :: inc de ; .vy

	; initialise effect activity indicators
	ld hl, wFlowRulesCache.doodads
	ld a, [hl+] :: ld h, [hl] :: ld l, a
		push hl ; @doodads.len
	; store doodads.len in FlowState
	ld a, [hl] :: ld [de], a :: inc de ; .sprite_count
	ld b, a ; request N sprites
	call SpritePoolAlloc
	ld c, l :: ld b, h ; sprite pointer
		pop hl ; @doodads.len
	jr nc, .err_sprite_pool_alloc_failed
	; store sprite pointer in FlowState
	ld a, c :: ld [de], a :: inc de
	ld a, b :: ld [de], a :: inc de

		wrambpush bank("wSpritePool")
	ld a, [hl+] :: ld e, a
:
		push bc :: push de
	call _DoDoodadPlace
		pop de :: pop bc
	; advance sprite pointer
	ld a, szSpriteInst
	add c :: ld c, a
	adc b :: sub c :: ld b, a

	dec e
	jr nz, :-
		wrambpop ; wSpritePool

	; return @end (HL)
	ld hl, wFlowRulesCache.end
	ld a, [hl+] :: ld h, [hl] :: ld l, a
		wrambpop ; wMapState
	ret

.err_sprite_pool_alloc_failed:
	ld b, b
	jr @-1


;; NOTE: Ensure SpriteInst WRAMX bank is active.
;; @param BC: sprite pointer
;; @param HL: source pointer (DoodadPlace)
;; @mut: AF, BC, DE, HL
_DoDoodadPlace:
	ld a, [hl+] :: ld e, a ; place.doodad
	ld a, [hl+] ; place.option
		push hl ; @ place.posy
		rombpush bank("SpriteTable")
	; HACK: assuming doodad ID maps to sprite table index
	call SprtabIndex
		push bc ; @ sprite.flags
	call SpriteInstantiate
		pop bc ; @ sprite.flags
		rombpop ; SpriteTable
		pop hl ; @ place.posy
	inc bc ; .flags
	; .posy
	ld a, [hl+] :: ld [bc], a :: inc bc
	ld a, [hl+] :: ld [bc], a :: inc bc
	; .posx
	ld a, [hl+] :: ld [bc], a :: inc bc
	ld a, [hl+] :: ld [bc], a :: inc bc
	ret


section "MapClose", rom0
;; Exit/close the map, disable Map processing.
;; @mut: AF
MapClose::
	ld a, MapCtl_CLEAR :: ldh [hMapCtl], a
	ret


section "MapSelect", rom0
;; Set the selected map. Disables Map processing.
;; @param DE: map address
;; @param A: map bank
;; @mut: AF
MapSelect::
	ldh [hMapSelectBank], a
	ld a, e :: ldh [hMapSelectAddr + 0], a
	ld a, d :: ldh [hMapSelectAddr + 1], a

	jp MapClose


section "MapUpdate", rom0
MapUpdate::
	ldh a, [hMapCtl]
	and MapCtl_PROCEN
	ret z

		rombpush
	ldh a, [hMapSelectBank]
	ld [$2000], a
		wrambpush

	call MapUpdateViewChunk
	call MapRenderScan

	;call _ProcessAllSynXfers

	ldh a, [hScrollStat]
	bit bScrollStat_ChangeFrontY, a
	jr z, :+
	ldh a, [hScrollFrontY]
	ld e, a
	call MapSyncFrontRow
:

	ldh a, [hScrollStat]
	bit bScrollStat_ChangeFrontX, a
	jr z, :+
	ldh a, [hScrollFrontX]
	ld e, a
	call MapSyncFrontColumn
:

	call MapHelloItems

	assert bank(wMapState) == bank(wMapEntitySlots)
	wrambsel bank(wMapState)
	call MapEntityUpdateAll

		wrambpop
		rombpop ; hMapSelectBank
	ret


section "MapHelloItems", rom0
;; Experiment / Proof of concept: render central view chunk's items
;; BANKNOTE: Caller must ensure selected map data is accessible.
MapHelloItems:
	; big big mega oam share/flicker time party
	ld d, 0 ; always show centre chunk
	ld hl, wActiveChunk_1_1.origin_y :: call MapHelloChunkItems

	ld a, [wVBlankCount]
	rrca
	jr nc, .half1

.half0:
	ld a, [wShareOb.minor0]
	ld d, a
	rrca :: ld [wShareOb.minor0], a
	ld hl, wActiveChunk_1_2.origin_y :: call MapHelloChunkItems
	ld hl, wActiveChunk_2_1.origin_y :: call MapHelloChunkItems
	ld hl, wActiveChunk_1_0.origin_y :: call MapHelloChunkItems
	ld hl, wActiveChunk_0_1.origin_y :: call MapHelloChunkItems
	ret
.half1:
	ld a, [wShareOb.minor1]
	ld d, a
	rrca :: ld [wShareOb.minor1], a
	ld hl, wActiveChunk_2_2.origin_y :: call MapHelloChunkItems
	ld hl, wActiveChunk_2_0.origin_y :: call MapHelloChunkItems
	ld hl, wActiveChunk_0_0.origin_y :: call MapHelloChunkItems
	ld hl, wActiveChunk_0_2.origin_y :: call MapHelloChunkItems
	ret

MapHelloChunkItems:
	; calc Y screen position
	ld a, [wScroll.y + 0] :: ld c, a
	ld a, [wScroll.y + 1] :: ld b, a
	ld a, [hl+]
	sub c
	ld [wItemObBuild.chunk_scr_y + 0], a :: ld c, a
	ld a, [hl+]
	sbc b
	ld [wItemObBuild.chunk_scr_y + 1], a
	; need high byte of $00 or $FF for any items to be visible.
	jr z, .ypositive ; $00?
	inc a
	ret nz ; $FF?
.ynegative:
	; high byte is $FF (negative), low byte must be greater than 120 for any item to be visible.
	ld a, 120
	cp c
	jr c, .yok
	ret
.ypositive:
	; high byte is $00, low byte must be less than (144+16) for any item to be visible.
	ld a, c
	cp 144 + 16
	ret nc
.yok:

	; calc X screen position
	ld a, [wScroll.x + 0] :: ld c, a
	ld a, [wScroll.x + 1] :: ld b, a
	ld a, [hl+]
	sub c
	ld [wItemObBuild.chunk_scr_x + 0], a :: ld c, a
	ld a, [hl+]
	sbc b
	ld [wItemObBuild.chunk_scr_x + 1], a
	; need high byte of $00 or $FF for any items to be visible.
	jr z, .xpositive ; $00?
	inc a
	ret nz ; $FF?
.xnegative:
	; high byte is $FF (negative), low byte must be greater than 120 for any item to be visible.
	ld a, 120
	cp c
	jr c, .xok
	ret
.xpositive:
	; high byte is $00, low byte must be less than (160+8) for any item to be visible.
	ld a, c
	cp 160 + 8
	ret nc
.xok:

	; follow items pointer
	ld bc, wActiveChunk_1_1.items - (wActiveChunk_1_1.origin_x + 2)
	add hl, bc
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	; if .items == $FFFF, this slot is empty.
	and h :: inc a
	ret z


		;; FALLTHROUGH


pushs "wShareOb", wram0
;; Oam sharing / sprite flicker states -- for chunk items
wShareOb:
	.minor0: db
	.minor1: db

pops ; wShareOb


;; @param D: share
;; @param HL: pointer to items collection in chunk
;; @param [wItemObBuild.chunk_scr_x]: chunk origin on screen, X axis
;; @param [wItemObBuild.chunk_scr_y]: chunk origin on screen, Y axis
_RenderChunkItems:
	ld a, [hl+] :: ld c, a ; len
	ld a, c :: and a
	ret z ; len == 0

	ld b, d ; Live share ob state in B

	call ObdoCustomStartDE
.item_draw_loop:
	ld a, [hl+] ; item.id
		push bc :: push de :: push hl
	ld b, a ; query item id
	call MapCollectionTrashQuery
		pop hl :: pop de :: pop bc
	jr c, :+
.err_collection_query_failed
	ld b, b
	jr .err_collection_query_failed
:
	jr nz, .skip

	; share oam slots
	ld a, b
	and a
	jr z, :+
	xor c
	rrca
	jr nc, :+
.skip:
	inc hl :: inc hl :: inc hl ; skip posy, posx, item
	jr .continue2
:
		push bc ; loop counter
	; calc item_scr_y = chunk_scr_y + item_local
	ld a, [wItemObBuild.chunk_scr_y + 0] :: ld c, a
	ld a, [hl+] :: add c :: ld c, a
	ld a, [wItemObBuild.chunk_scr_y + 1]
	adc c :: sub c
	; if high byte is not zero, ob will not be visible.
	jr z, :+
	inc hl :: inc hl ; skip posx, item
	jr .continue
:
	; if Y >= 160, no visi
	ld a, c
	cp 160
	jr c, :+
	inc hl :: inc hl ; skip posx, item
	jr .continue
:

	; OAM position is just low byte of 16-bit screen position
	ld b, c ; Y

	; calc item_scr_x = chunk_scr_x + item_local
	ld a, [wItemObBuild.chunk_scr_x + 0] :: ld c, a
	ld a, [hl+] :: add c :: ld c, a
	ld a, [wItemObBuild.chunk_scr_x + 1]
	adc c :: sub c
	; if high byte is not zero, ob will not be visible.
	jr z, :+
	inc hl ; skip item
	jr .continue
:
	; if X >= 168, no visi
	ld a, c
	cp 168
	jr c, :+
	inc hl ; skip item
	jr .continue
:

	; OAM X position already in C

	; (close enough to) visible, build ob
	ld a, b :: ld [de], a :: inc de ; Y
	ld a, c :: ld [de], a :: inc de ; X

	; TESTING: draw items using a variety of CHRs
	ld a, l :: rrca :: rrca :: and $07
	add 96 :: ld c, a
	ld a, [hl+] ; item type
	add c :: ld [de], a :: inc de ; chri
	ld a, 4 :: ld [de], a :: inc de ; pal/atrb
.continue
		pop bc ; loop counter
.continue2
	dec c
	jr nz, .item_draw_loop
	call ObdoCustomEndDE

	; return updated share ob state
	ld d, b
	ret


pushs "wItemObBuild", wram0
wItemObBuild::
	.chunk_scr_y:: dw
	.chunk_scr_x:: dw
	; CHUNK_ITEMS_MAX

pops ; wItemObBuild


section "MapGetPlayerStart", rom0
;; @ret BC: Y position
;; @ret DE: X position
;; @mut: AF, BC, DE, HL
MapGetPlayerStart::
	ld hl, wMapPlayerStartY
	ld a, [hl+] :: ld c, a ; y.lo
	ld a, [hl+] :: ld b, a ; y.hi
	ld a, [hl+] :: ld e, a ; x.lo
	ld a, [hl+] :: ld d, a ; x.hi
	ret


section "MapSyncVisible", rom0
;; Force bulk sync of visible region.
;; @mut: AF, BC, DE, HL
MapSyncVisible::
		rombpush
	ldh a, [hMapSelectBank]
	ld [$2000], a
		wrambpush

	call MapUpdateViewChunk
	call MapRenderScan
	call MapRenderScan
	call MapRenderScan
	ld d, 20
	ld a, [wScroll.row]
	dec a
:
	ld a, e
	and $1F
	ld e, a
	push de
	call MapSyncFrontRow
	pop de
	inc e
	dec d
	jr nz, :-

		wrambpop
		rombpop ; hMapSelectBank
	ret


section "MapSyncFront", rom0
;; @param E: Y
;; @mut: AF, BC, DE, HL
MapSyncFrontRow:
	; row X position
	ld a, [wScroll.column + 0]
	dec a ; viewX - 1 so corners get painted
	ld b, a
	and $1F :: ldh [_destX], a

	ld a, e :: and $1F :: ldh [_destY], a

	; get tile row at map view origin
	ldh a, [hMapViewChunkY]
	dec a :: swap a :: and $F0 :: ld d, a
	; relative position of the 'front' (from map view origin) in tile coords
	ld a, e :: sub d :: ld d, a

	jp MapSyncRow


;; @param E: X
;; @mut: AF, BC, DE, HL
MapSyncFrontColumn:
	; column Y position
	ld a, [wScroll.row + 0]
	dec a ; viewY - 1 so corners get painted
	ld b, a
	and $1F :: ldh [_destY], a

	ld a, e :: and $1F :: ldh [_destX], a

	; get tile column at map view origin
	ldh a, [hMapViewChunkX]
	dec a :: swap a :: and $F0 :: ld d, a
	; relative position of the 'front' (from map view origin) in tile coords
	ld a, e :: sub d :: ld d, a

	jp MapSyncColumn


section "MapSync", rom0
;; Initialise sync xfers -- set the srcU start offset and length.
;; @param E: srcU
;; @param C: totalLength
;; @mut: AF, B
SynXferInitialLayout:
	; Reset srcIndex for slot 1 & 2
	xor a
	ldh [_Xfer1 + SynXfer_srcIndex], a
	ldh [_Xfer2 + SynXfer_srcIndex], a
	; srcU will be in slot0 or slot1, so we'll just branch and handle each case separately.
	ld a, e
	cp 16
	jr c, .start_u0
.start_u1 ; if srcU in [16..31]: start in slot 1
	; u1 = srcU - 16
	sub 16 :: ldh [_Xfer1 + SynXfer_srcIndex], a
	; len1 = 16 - u1 = 32 - srcU
	ld a, 32 :: sub e :: ldh [_Xfer1 + SynXfer_length], a
	; len2 = totalLength - len1
	ld b, a
	ld a, c :: sub b :: ldh [_Xfer2 + SynXfer_length], a
	; len0 = 0
	xor a :: ldh [_Xfer0 + SynXfer_length], a
	ret

.start_u0 ; if srcU in [0..15]: start in slot 0
	; u0 = srcU
	ldh [_Xfer0 + SynXfer_srcIndex], a
	; len0 = 16 - u0
	ld a, 16 :: sub e :: ldh [_Xfer0 + SynXfer_length], a
	; lenRemaining = totalLen - len0
	ld b, a :: ld a, c :: sub b
	cp 17
	jr c, .end_u1

.end_u2 ; if lenRemaining > 16: end in slot 2
	; len2 = lenRemaining - len1
	sub 16 :: ldh [_Xfer2 + SynXfer_length], a
	ld a, 16 :: ldh [_Xfer1 + SynXfer_length], a
	ret

.end_u1 ; lenRemaining <= 16: end in slot 1
	; len1 = lenRemaining
	ldh [_Xfer1 + SynXfer_length], a
	xor a :: ldh [_Xfer2 + SynXfer_length], a
	ret


;; Transfer a row from cache to the bgmap buffers.
;; @param B: row start X coordinate
;; @param D: srcY
;; @mut: AF, BC, DE, HL
MapSyncRow:
	; calculate srcX
	ld a, b
	sub 5 :: and $0F :: add 5
	ld e, a
	ld c, 23
	call SynXferInitialLayout

	; srcV = (srcY % 16) * 16
	ld a, d :: and $0F :: swap a :: ld b, a

	; Set C to the left slot (NW, WW, SW) that contains the row to sync.
	ld c, low(hMapChunkSlots + 0)
	ld a, d
	sub 16
	; if srcY in [0..15]: top 3 slots
	jr c, .finalise
	ld c, low(hMapChunkSlots + 3)
	sub 16
	; if srcY in [16..31]: middle 3 slots
	jr c, .finalise
	ld c, low(hMapChunkSlots + 6)
	; else srcY in [32..47]: bottom 3 slots

.finalise:
	ld hl, _Xfer0
	call _FinaliseRowXfer
	ld hl, _Xfer1
	call _FinaliseRowXfer
	ld hl, _Xfer2
	call _FinaliseRowXfer

	jp _ProcessAllSynXfers


;; @param B: common buffer offset
;; @param C: low byte pointer to slot status
;; @param HL: pointer to SynXfer
;; @mut: AF, C, DE, HL
_FinaliseRowXfer:
	; status -- slot index & flags
	ld a, c :: sub low(hMapChunkSlots)
	ld d, a
	ldh a, [c]
	and SLOT_RENDERED | SLOT_NOCHUNK
	or d
	ld [hl+], a ; .status

	; Check xfer length
	ld a, [hl] ; .length
	and a
	jr z, .end

	; Destination address from grid position
	ldh a, [_destY]
	; Multiply Y by 32. The result requires 2 bytes but initially both bytes are combined.
	swap a :: rlca
	ld e, a
	; The lowest 5 bits are the high byte of the result.
	and $1F :: ld d, a
	; Finally, subtract the high byte from the combined result to get the low byte on its own.
	; NOTE: adding the X offset here won't cause overflow, assuming a valid value in `[0..31]`.
	ldh a, [_destX] :: add e :: sub d :: ld e, a

	; Advance destination X coord by xfer length
	ldh a, [_destX]
	add [hl] :: and $1F
	ldh [_destX], a
	inc hl

	; Store dest index
	ld a, e :: ld [hl+], a ; dest.0
	ld a, d :: ld [hl+], a ; dest.1

	; If slot has NOCHUNK set, this xfer will be skipped & we have nothing else to do.
	; NOTE: this check must come after updating destination coord.
	ldh a, [c]
	bit bSLOT_NOCHUNK, a
	jr nz, .end

	; srcIndex -- source address low byte
	ld a, [hl] ; .srcIndex holds srcU initially
	add b
	ld [hl+], a ; srcIndex

.end:
	inc c
	ret


;; Transfer a column from cache to the bgmap buffers.
;; @param B: column start Y coordinate
;; @param D: srcX
;; @mut: AF, BC, DE, HL
MapSyncColumn:
	; calculate srcY: starting row, top row of view rect
	ld a, b
	sub 6 :: and $0F :: add 6
	ld e, a
	ld c, 21
	call SynXferInitialLayout

	; srcV = srcX % 16
	ld a, d :: and $0F :: ld b, a

	; Set C to the top slot (NW, NN, NE) that contains the column to sync. (*the column being sunc*)
	ld c, low(hMapChunkSlots)
	ld a, d
	sub 16
	; if srcX in [0..15]: west 3 slots
	jr c, .finalise
	inc c
	sub 16
	; if srcX in [16..31]: middle 3 slots
	jr c, .finalise
	inc c
	; else srcX in [32..47]: east 3 slots

.finalise:
	ld hl, _Xfer0
	call _FinaliseColumnXfer
	ld hl, _Xfer1
	call _FinaliseColumnXfer
	ld hl, _Xfer2
	call _FinaliseColumnXfer

	jp _ProcessAllSynXfers


;; @param B: common buffer offset ... srcX
;; @param C: low byte pointer to slot status
;; @param HL: pointer to xfer params
;; @mut: AF, C, DE, HL
_FinaliseColumnXfer:
	; status -- slot index & flags
	ld a, c :: sub low(hMapChunkSlots)
	or SynXfer_COLUMN
	ld d, a
	ldh a, [c]
	and SLOT_RENDERED | SLOT_NOCHUNK
	or d
	ld [hl+], a ; .status

	; Check xfer length
	ld a, [hl+] ; .length
	and a
	jr z, .end
	ld d, a
	; Destination address from grid position
	ldh a, [_destY] :: ld e, a
	; Advance destination Y coord by xfer length
	add d :: and $1F
	ldh [_destY], a
	; Multiply Y by 32. The result requires 2 bytes but initially both bytes are combined.
	ld a, e :: swap a :: rlca
	ld e, a
	; The lowest 5 bits are the high byte of the result.
	and $1F :: ld d, a
	; Finally, subtract the high byte from the combined result to get the low byte on its own.
	; NOTE: adding the X offset here won't cause overflow, assuming a valid value in `[0..31]`.
	ldh a, [_destX] :: add e :: sub d
	; ld e, a
	; ld a, e
	ld [hl+], a ; dest.0
	ld a, d :: ld [hl+], a ; dest.1

	; If slot has NOCHUNK set, this xfer will be skipped & we have nothing else to do.
	; NOTE: this check must come after updating destination coord.
	ldh a, [c]
	bit bSLOT_NOCHUNK, a
	jr nz, .end

	; srcIndex -- source address low byte
	ld a, [hl] ; .srcIndex holds srcU initially
	; srcIndex = srcV + (srcU % 16) * 16
	and $0F :: swap a :: add b
	ld [hl+], a ; srcIndex

.end:
	inc c :: inc c :: inc c ; C += 3
	ret


_ProcessAllSynXfers:
	; Process the transfers -- update the BG map
		wrambpush

	ld hl, _Xfer0
	call _ProcessSynXfer
	ld hl, _Xfer1
	call _ProcessSynXfer
	ld hl, _Xfer2
	call _ProcessSynXfer

		wrambpop
	ret


;; @param HL: pointer to SynXfer
;; @mut: AF, BC, DE, HL
_ProcessSynXfer:
	ld a, [hl] ; .status
	ldh [_xfer_status], a
	; Check Xfer needs doing
	and SynXfer_SKIP | SynXfer_DONE
	ret nz

	; get source slot index
	ldh a, [_xfer_status]
	and SynXfer_SLOT_INDEX
	cp 10 :: ret nc ; TODO: probably redundant (SKIP should be set, RENDERED should not be)
	add low(hMapChunkSlots)
	ld c, a
	; check slot's current status
	; TOMAYBEDO: also check that slot is the same as when the Xfer was configured...
	ldh a, [c]
	bit bSLOT_RENDERED, a
	ret z

	; mark xfer as DONE
	set bSynXfer_DONE, [hl]
	inc hl

	; Check that xfer length is nonzero
	ld a, [hl+] ; .length
	and a :: ret z
	ld b, a

	; .destIndex
	ld a, [hl+] :: ld e, a
	ld a, [hl+] :: ld d, a

	; .srcIndex (src address low byte)
	ld l, [hl]
	; src buffer address (high byte)
	ldh a, [c] :: and SLOT_BUFFER :: or $D0
	ld h, a

	; keep xfer status in C
	ldh a, [_xfer_status]
	ld c, a

	ld a, MAP_CHR_BUFFER_BANK :: ldh [rSVBK], a
	push bc :: push de :: push hl
	ld a, d :: add high(wMapBgChr) :: ld d, a

	bit bSynXfer_ORIENTATION, c
	call _xfer_loop

	ld a, MAP_ATRB_BUFFER_BANK :: ldh [rSVBK], a
	pop hl :: pop de :: pop bc
	ld a, d :: add high(wMapBgAtrb) :: ld d, a

	bit bSynXfer_ORIENTATION, c
	call _xfer_loop

	; Queue map sync
	; NOTE: Just doing the whole map, ...
	ld e, 0
	ld c, 63
	call VxSyncBgChr
	jp VxSyncBgAtrb


;; @param B: length
;; @param DE: destination address
;; @param HL: source address
;; @param F.Z: Z = orientation is ROW, NZ = orientation is COLUMN
;; @mut: AF, B, DE, HL
_xfer_loop:
	jr z, .xfer_loop_row
.xfer_loop_column:
	ld a, [hl]
	ld [de], a

	ld a, 32
	add e :: ld e, a
	adc d :: sub e :: ld d, a

	ld a, 16
	add l :: ld l, a
	adc h :: sub l :: ld h, a

	dec b
	jr nz, .xfer_loop_column
	ret

.xfer_loop_row:
	ld a, [hl+]
	ld [de], a :: inc de
	dec b
	jr nz, .xfer_loop_row
	ret


section "MapRenderSlot", rom0
;; Regular scan and render chunks in view, as needed.
;; NOTE: Map data must be accessible.
;; NOTE: Changes WRAMX bank (no restore).
;; @mut: AF, BC, DE, HL
MapRenderScan:
	call MapRenderNextSlot
	call MapRenderNextSlot

	; FALLTHROUGH

;; If needed, render the chunk in the 'next' slot (specified by [hMapSlotIdx]).
;; Advance the 'next' slot index.
;; NOTE: Map data must be accessible.
;; NOTE: Changes WRAMX bank (no restore).
;; @param L: index
;; @mut: AF, BC, DE, HL
MapRenderNextSlot:
	ldh a, [hMapSlotIdx] :: ld l, a
	inc a
	cp MAP_CHUNK_BUFFER_COUNT
	jr c, :+
	xor a
:
	ldh [hMapSlotIdx], a

	; FALLTHROUGH

;; Render the chunk in the given slot, if it hasn't been already.
;; NOTE: Map data must be accessible.
;; NOTE: Changes WRAMX bank (no restore).
;; @param L: index
;; @mut: AF, BC, DE, HL
MapRenderSlot:
	ld a, l :: add low(hMapChunkSlots) :: ld c, a
	ldh a, [c]
	and SLOT_RENDERED | SLOT_NOCHUNK
	ret nz
	ldh a, [c]
	or SLOT_NOCHUNK
	ldh [c], a

	ld a, low(MapSlotCoords) >> 1
	add l :: add a :: ld l, a ; (base/2 + index) * 2
	ld h, high(MapSlotCoords)

	ldh a, [hMapViewChunkY]
	add [hl] :: inc hl
	ld d, a

	ldh a, [hMapViewChunkX]
	add [hl]
	ld e, a

	; Chunk lookup
	ld hl, wMapHeader.chunk_table
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	call MapChunkLookup
	ret nc

	; DE = chunk buffer dest
	ldh a, [c] :: and SLOT_BUFFER :: or $D0
	ld d, a :: ld e, 0
		push de ; keep destination for ATRB
	; CHR brushes
	ld hl, wMapChunkHeader.brushes0
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	ld a, MAP_CHR_BUFFER_BANK :: ldh [rSVBK], a
	call MapChunkRender
		pop de
	; ATRB brushes
	ld hl, wMapChunkHeader.brushes1
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	ld a, MAP_ATRB_BUFFER_BANK :: ldh [rSVBK], a
	call MapChunkRender

	; update slot status
	ldh a, [c]
	xor SLOT_RENDERED | SLOT_NOCHUNK ; clear NOCHUNK & set RENDERED
	ldh [c], a
	ret


section "MapSlotCoords", rom0
;; Lookup table for 3x3 chunk slot coords, relative to central "view" chunk.
;; Each entry contains a signed offset for each axis: `{ dY: db, dX: db }`.
;; Arranged in row-major order, top-to-bottom, left-to-right.
MapSlotCoords: align 5
db -1, -1
db -1, +0
db -1, +1
db +0, -1
db +0, +0
db +0, +1
db +1, -1
db +1, +0
db +1, +1
	.end


section "MapUpdateViewChunk", rom0
;; Update visible chunks from scroll position.
;; BANKNOTE: Caller must ensure selected map data is accessible.
;; @mut: AF, BC, DE, HL
MapUpdateViewChunk:
	call _UpdateViewChunk
	ld a, b :: or c
	ret z ; no change

	; update wActiveChunk cache/info
	ld hl, wActiveChunk_0_0
	ld bc, MapSlotCoords
:
		push de ; view chunk coord (centre)
	; add slot coord offset
	assert MapSlotCoords & $1F == 0
	ld a, [bc] :: inc c
	add d :: ld d, a
	ld a, [bc] :: inc c
	add e :: ld e, a
		push bc
	call _UpdateActiveChunkSlot
		pop bc
		pop de
	; end loop when at end of MapSlotCoords
	ld a, c
	cp low(MapSlotCoords.end)
	jr c, :-

	ret


;; @param D,E: Y,X chunk coord (in map)
;; @param HL: pointer to active chunk record
;; @ret HL: end of active chunk record
;; @mut: AF, BC, DE, HL
_UpdateActiveChunkSlot:
	ld a, d :: ld [hl+], a ; coord Y
	ld a, e :: ld [hl+], a ; coord X

	; calc origin Y
	ld a, d :: rrca :: ld c, a
	and $7F :: ld b, a
	xor c ; keep bit 7
	add 16 ; offset so Y < 0 indicates off-screen
	; store origin Y
	ld [hl+], a
	ld a, b :: ld [hl+], a

	; calc origin X
	ld a, e :: rrca :: ld c, a
	and $7F :: ld b, a
	xor c
	add 8 ; offset so X < 0 indicates off-screen
	; store origin X
	ld [hl+], a
	ld a, b :: ld [hl+], a

		push hl ; @ chunk.header
	call MapChunkLookup2
	ld d, h :: ld e, l
		pop hl ; @ chunk.header
	; Copy chunk header to cache if lookup succeeded, or fill cache with $FF otherwise.
	ld c, szMapChunkHeader
	; NOTE: using F.C from MapChunkLookup2 here!
	jp c, MemCopySmall
	ld a, $FF
	jp MemFillSmall


;; Update visible chunks from scroll position.
;; @ret D,E: Y,X chunk view coord (new)
;; @ret B,C: Y,X chunk view coord delta
;; @mut: AF, BC, DE, HL
_UpdateViewChunk:
	; Update X axis chunk view position & slots
	ld c, low(hMapViewChunkX)
	ldh a, [c] :: ld b, a
	; X axis view position (world dots) to chunk coords
	ld hl, wScroll.x
	ld a, [hl+]
	ld h, [hl]
	add 80 ; offset to view rect centre
	ld l, a
	adc h
	sub l
	ld h, a
	; divide by 128: hi.0 <~~ lo.7
	ld a, l
	rla
	ld a, h
	rla

	ldh [c], a ; save newX
	ld e, a ; return newX
	sub b :: ld d, a ; temp. hold deltaX in D
	call nz, _UpdateSlotsX

	; Update Y axis chunk view position & slots
	dec c :: ldh a, [c] :: ld b, a
	; Y axis view position (world dots) to chunk coords
	ld hl, wScroll.y
	ld a, [hl+]
	ld h, [hl]
	add 72 ; offset to view rect centre
	ld l, a
	adc h
	sub l
	ld h, a
	; divide by 128: hi.0 <~~ lo.7
	ld a, l
	rla
	ld a, h
	rla

	ldh [c], a ; save newY
	ld c, d ; return deltaX
	ld d, a ; return newY
	sub b :: ld b, a ; return deltaY
	jr nz, _UpdateSlotsY
	ret


;; @mut: A
_ResetAllSlots:
for I, MAP_CHUNK_BUFFER_COUNT
	ld a, CHUNK_BUFFER_{d:I} :: ldh [hMapChunkSlots + I], a
endr
	ret


;; @param AF: result of newX - oldX
;; @mut: AF, B, HL
_UpdateSlotsX:
	jr c, .neg
	; (newX - oldX) > 0: scroll right ~~ shift left
	dec a :: jr z, _SlotsShiftLeft
	jr _ResetAllSlots
.neg
	; (newX - oldX) < 0: scroll left ~~ shift right
	inc a :: jr z, _SlotsShiftRight
	jr _ResetAllSlots


;; @param AF: result of newY - oldY
;; @mut: AF, HL
_UpdateSlotsY:
	jr c, .neg
	; (newY - Y) > 0: scroll down ~~ shift up
	dec a :: jr z, _SlotsShiftUp
	jr _ResetAllSlots
.neg
	; (newY - Y) < 0: scroll up ~~ shift down
	inc a :: jr z, _SlotsShiftDown
	jr _ResetAllSlots


;; @mut: AF, B, HL
_SlotsShiftLeft:
	ld hl, hMapChunkSlots

for I, 3
	ld b, [hl]
	ldh a, [hMapChunkSlots + I * 3 + 1] :: ld [hl+], a
	ldh a, [hMapChunkSlots + I * 3 + 2] :: ld [hl+], a
	ld a, b :: and SLOT_BUFFER :: ld [hl+], a
endr
	ret


;; @mut: AF, B, HL
_SlotsShiftRight:
	ld hl, hMapChunkSlots

for I, 3
	ld b, [hl]
	ldh a, [hMapChunkSlots + I * 3 + 2] :: and SLOT_BUFFER :: ld [hl+], a
	ld a, b :: ld b, [hl] :: ld [hl+], a
	ld a, b :: ld [hl+], a
endr
	ret


;; Shift the chunk slots up (by one row)
;; @mut: AF, HL
_SlotsShiftUp:
	ld hl, hMapChunkSlots
	ld a, [hl+] :: and SLOT_BUFFER :: ldh [hMapChunkSlotsScratch + 0], a
	ld a, [hl+] :: and SLOT_BUFFER :: ldh [hMapChunkSlotsScratch + 1], a
	ld a, [hl+] :: and SLOT_BUFFER :: ldh [hMapChunkSlotsScratch + 2], a
for I, MAP_CHUNK_BUFFER_COUNT
	ld a, [hl+] :: ldh [hMapChunkSlots + I], a
endr
	ret


;; Shift the chunk slots down (by one row)
;; @mut: AF, HL
_SlotsShiftDown:
	ld hl, hMapChunkSlotsScratch + 2
for I, MAP_CHUNK_BUFFER_COUNT
	ldh a, [hMapChunkSlots + MAP_CHUNK_BUFFER_COUNT - I - 1] :: ld [hl-], a
endr
	ldh a, [hMapChunkSlotsScratch + 2] :: and SLOT_BUFFER :: ld [hl-], a
	ldh a, [hMapChunkSlotsScratch + 1] :: and SLOT_BUFFER :: ld [hl-], a
	ldh a, [hMapChunkSlotsScratch + 0] :: and SLOT_BUFFER :: ld [hl-], a
	ret


section "MapChunkTransfer", rom0
;; Copy a chunk (16 * 16) to a bg map buffer (32 * 32)
;; @param DE: source (chunk buffer)
;; @param HL: dest (bg map)
;; @mut: AF, BC, DE, HL
MapChunkTransfer::
	ld b, 16 ; Y
	ld c, b ; X
.loop
	ld a, [de] :: inc de
	ld [hl+], a
	dec c
	jr nz, .loop
	; bg map is 32 wide, so add an additional 16 to `dest` (HL)
	ld a, 16
	ld c, a ; reset C also!
	add l :: ld l, a
	adc h :: sub l :: ld h, a

	dec b
	jr nz, .loop
	ret


section "MapChunkRender", rom0
;; Render a chunk to a chunk buffer.
;; @param HL: source chunk brushes
;; @param DE: dest (chunk buffer)
;; @mut: AF, B, DE, HL
MapChunkRender::
.continue:
	ld a, [hl+]
	and BR__TYPE
	assert BR_TERM == 0
	ret z
	assert BR_SOLID == 1
	dec a :: jr z, .br_solid

.err_unhandled_brush:
	ld b, b
	jr .err_unhandled_brush

.br_solid:
	ld a, [hl+]
	ld b, a
	inc b ; brush data has length - 1
	ld a, [hl+]
:
	ld [de], a :: inc de
	dec b
	jr nz, :-
	jr .continue


/*
section "test/map/chunk_render", rom0
Test_map_chunk_render:
		rombopen bank(map_test)
	ld hl, map_test.chunk_table
	ld de, (0 << 8) | 4
	call MapChunkLookup
	jr nc, .err
	; skip 2 byte atrb pointer
	inc hl :: inc hl

		wrambpush bank(wMapBufferChr0)
	ld de, wMapBufferChr0
	call MapChunkRender

	ld de, wMapBufferChr0
	ld hl, wMapBgChr
	call MapChunkTransfer
		wrambpop

	ret
.err:
	ld b, b
	halt :: nop
	jr .err
*/


section "MapChunkLookup2", rom0
;; Chunk table spatial lookup in the open map.
;; Searches the map's chunk table for a chunk at the given chunk coordinates.
;; BANKNOTE: Caller must ensure selected map data is accessible.
;; @param D,E: row,column
;; @ret HL: pointer to chunk data
;; @ret F.C: set if successful
;; @mut: AF, B, HL
MapChunkLookup2::
	ld hl, wMapHeader.chunk_table
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	ld a, [hl+]
	ld b, a
:
	ld a, [hl+]
	cp d
	jr z, .xtable
	inc hl :: inc hl
	dec b
	jr nz, :-
	jr .fail
.xtable:
	ld a, [hl+]
	ld h, [hl]
	ld l, a
	ld a, [hl+]
	ld b, a
:
	ld a, [hl+]
	cp e
	jr z, .ok
	inc hl :: inc hl
	dec b
	jr nz, :-
.fail:
	xor a ; clear F.C
	ret
.ok:
	ld a, [hl+]
	ld h, [hl]
	ld l, a

	scf
	ret


section "MapChunkLookup", rom0
;; Chunk table spatial lookup -- get chunk at chunk coordinates location.
;; If successful, the chunk's header is copied to wMapChunkHeader.
;; @param HL: Chunk Table
;; @param D,E: row,column
;; @ret F.C: set if successful
;; @mut: AF, B, HL
MapChunkLookup::
	ld a, [hl+]
	ld b, a
:
	ld a, [hl+]
	cp d
	jr z, .xtable
	inc hl :: inc hl
	dec b
	jr nz, :-
	jr .fail
.xtable:
	ld a, [hl+]
	ld h, [hl]
	ld l, a
	ld a, [hl+]
	ld b, a
:
	ld a, [hl+]
	cp e
	jr z, .ok
	inc hl :: inc hl
	dec b
	jr nz, :-
.fail:
	xor a ; clear F.C
	ret
.ok:
	ld a, [hl+]
	ld h, [hl]
	ld l, a

		push de
	; Copy header to cache
	ld de, wMapChunkHeader
	ld b, szMapChunkHeader
:
	ld a, [hl+]
	ld [de], a :: inc de
	dec b
	jr nz, :-
		pop de

	scf
	ret


/*
section "test/map/chunk_lookup", rom0
Test_map_chunk_lookup::
	ld b, b
for Y, 6
	for X, 6
.test_{d:Y}_{d:X}:
	ld a, bank(map_test)
	ld [$2000], a
	ld hl, map_test.chunk_table
	ld de, (Y << 8) | X
	call MapChunkLookup
	ld b, b
	endr
endr
	ret

*/


section "MapZoneQuery", rom0
;; Find Zone(Rules) that contains point (if any).
;; @param BC: query point Y (dots)
;; @param DE: query point X (dots)
;; @ret F.C: Set if point in zone
;; @ret DE: Rules applicable to zone (only valid with F.C)
;; @mut: AF, BC, DE, HL
MapZoneQuery::
		rombpush
	ldh a, [hMapSelectBank]
	ld [ROMB_LO], a
		push de :: push bc
	; dots to chunk coord for MapChunkLookup (D,E: row,column)
	rl e :: rl d :: ld e, d ; X
	ld d, b :: rl c :: rl d ; Y

	ld hl, wMapHeader.chunk_table
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	call MapChunkLookup
		pop bc :: pop de
	jr nc, .exit_miss

	ld hl, wMapChunkHeader.elements
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	ld a, [hl+] :: ld b, a ; number of items
	; early out if zero items
	and a
	jr z, .exit_miss

	; query point relative to chunk
	; NOTE: `res 7, R8` faster than equiv. using `and $7F`
	res 7, c ; Y
	res 7, e ; X

	; iterate elements
.loop
	; filter ChunkZone type
	ld a, [hl+] ; .typeid.0
	inc hl ; skip typeid.1
	cp MapObject_CHUNK_ZONE
	jr nz, .err_unexpected_typeid
		push hl
	; Y
	; rel = p - min; rel < 0 ? miss
	ld a, c :: sub [hl] :: jr c, .continue
	inc hl
	; rel >= size ? miss
	cp [hl] :: jr nc, .continue ; compare relative point in zone with size
	inc hl

	; X
	ld a, e :: sub [hl] :: jr c, .continue
	inc hl
	cp [hl] :: jr nc, .continue
	inc hl

	; hit
	ld a, [hl+] :: ld e, a
	ld a, [hl+] :: ld d, a

		pop af ; discard stashed element pointer
		rombpop
	scf
	ret

.continue
		pop hl
	ld a, szChunkZone
	add l :: ld l, a
	adc h :: sub l :: ld h, a

	dec b
	jr nz, .loop

.exit_miss:
		rombpop
	and a ; Clear F.C
	ret

.err_unexpected_typeid:
	ld b, b
	jr .err_unexpected_typeid


section "MapReset", rom0
;; Clear map state, cache, etc.
;; NOTE: This does **not** reset the selected map! (`hMapSelectAddr`, `hMapSelectBank`).
;; @mut: AF, BC, HL
MapReset::
	ld a, $FF
	ldh [hMapViewChunkY], a
	ldh [hMapViewChunkX], a

	; bit strings used for flickering item sprites
	ld a, %0101_0101
	ld [wShareOb.minor0], a
	ld [wShareOb.minor1], a

	call _ResetAllSlots

	xor a :: ldh [hMapSlotIdx], a

	ld b, SYN_XFER_COUNT * szSynXfer
	ld a, SynXfer_EMPTY
	ld c, low(_Xfer0)
:
	ldh [c], a :: inc c
	dec b
	jr nz, :-

	; reset MapEntitySlots
		wrambpush bank(wMapEntitySlots)
	ld hl, wMapEntitySlotsFilled
	xor a
	ld c, MAP_ENTITY_SLOTS_LENGTH * szMapEntitySlot + 1
	call MemFillSmall
		wrambpop ; wMapEntitySlots

		rombopen bank(xMapBufferInit)
	jp xMapBufferInit


section "xMapBufferInit", romx
;; Clear the BG map buffers.
;; @mut AF, BC, HL
xMapBufferInit::
	; Clear BG map
		wrambpush bank(wMapBgChr)
	ld hl, wMapBgChr
	ld bc, (MAP_SIZE - 1) + $1_01
:
	ld a, l :: ld [hl+], a
	dec c
	jr nz, :-
	dec b
	jr nz, :-

	; Clear BG attribute map
	ld a, bank(wMapBgAtrb) :: ldh [rSVBK], a
	ld hl, wMapBgAtrb
	ld bc, (MAP_SIZE - 1) + $1_01
	xor a
:
	ld [hl+], a
	dec c
	jr nz, :-
	dec b
	jr nz, :-

		wrambpop
	ret


section "MapInit", rom0
;; @mut: AF, BC, HL
MapInit::
	xor a
	ldh [hMapSelectBank], a
	ld a, $FF
	ldh [hMapSelectAddr + 0], a
	ldh [hMapSelectAddr + 1], a
	ld a, MapCtl_CLEAR :: ldh [hMapCtl], a
	jp MapReset

