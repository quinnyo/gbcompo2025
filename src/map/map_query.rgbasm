include "map.rgbinc"
include "banker.rgbinc"


pushs "wMapQuery", wram0
wMapQuery::
	;; Query point in world dots, Y axis
	.py:: dw
	;; Query point in world dots, X axis
	.px:: dw

	; ;; Y coord of chunk containing query point.
	; .chunkrow:: db
	; ;; X coord of chunk containing query point.
	; .chunkcol:: db
	; ;; Query point local to containing chunk, Y axis.
	; .chunkrely:: db
	; ;; Query point local to containing chunk, X axis.
	; .chunkrelx:: db

wMapQueryResult::
	;; Array of detected items (IDs) terminated with `MAP_ITEM_NULL`.
	;; ALIGNED: ends (at `.items_end`) with a low address byte of zero.
	.items:: ds MAP_QUERY_RESULT_MAX_ITEMS
		align 8
	;; Marks the end of items result buffer -- will always be `MAP_ITEM_NULL`.
	.items_end:: db

	;; Pointer to zone rules state applicable at query point (if any).
	;; These objects are kept in `wMapState` (user is responsible for banking).
	;; A value of $FF00 or greater indicates null result (no zone detected).
	.zone_rules:: dw

pops ; wMapQuery


pushs "MapQueryExecute", rom0
;; @mut: AF, BC, DE, HL
MapQueryExecute::
	; Prepare query
	ld hl, wMapQuery.py
	ld a, [hl+] :: ld c, a ; .py[0]
	rla ; F.C <=== .py[0] bit 7
	ld a, [hl+] :: ld b, a ; .py[1]
	rla :: ld d, a ; D <=== high(py << 1) = chunk row
		push bc ; py
	ld a, [hl+] :: ld c, a ; .px[0]
	rla ; F.C <=== .px[0] bit 7
	ld a, [hl+] :: ld b, a ; .px[1]
	rla :: ld e, a ; E <=== high(px << 1) = chunk column

	; ; Store containing chunk coord
	; ld a, d :: ld [hl+], a ; .chunkrow
	; ld a, e :: ld [hl+], a ; .chunkcol

	; Query point relative to containing chunk
	ld a, c ; px[0]
		pop bc ; py
	ld b, c :: res 7, b
	ld c, a :: res 7, c
	; ld a, b :: ld [hl+], a ; .chunkrely
	; ld a, c :: ld [hl+], a ; .chunkrelx

	; Access containing chunk
		rombpush
	ldh a, [hMapSelectBank]
	ld [ROMB_LO], a
		push bc ; chunkrel{y,x}
	call oMapChunkAccess
		pop bc ; chunkrel{y,x}
	jr nc, .end

	; Collectable item query
	ld hl, wMapChunkHeader.items
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	call _do_item_query

	; Chunk element / Zone query
	ld hl, wMapChunkHeader.elements
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	call _do_zone_query

.end:
		rombpop
	ret


;; The detectable vertical size of collectable items.
def MAP_ITEM_DETECT_HEIGHT equ 24
def MAP_ITEM_DETECT_OFFSET_Y equ (MAP_ITEM_DETECT_HEIGHT >> 1) - 4 ; sub to ref. Ob centre
;; The detectable horizontal size of collectable items.
def MAP_ITEM_DETECT_WIDTH equ 24
def MAP_ITEM_DETECT_OFFSET_X equ (MAP_ITEM_DETECT_WIDTH >> 1) - 4


;; Perform the collectable item query.
;; @param HL: chunk.items
;; @param B,C: Y,X query point local to chunk
;; @mut: AF, DE, HL
_do_item_query:
	ld de, wMapQueryResult.items
	inc hl ; skip items.len (relying on array terminator)
.loop_items:
	; Get item ID and write it to the results array immediately.
	; NOTE: The results array pointer (DE) is not incremented unless the item
	; contains the query point!
	ld a, [hl+] :: ld [de], a
	cp MAP_ITEM_NULL ; check for terminator
	ret z

	; Y
	ld a, b :: sub [hl] :: add MAP_ITEM_DETECT_OFFSET_Y ; l = q - (P - D / 2)
	cp MAP_ITEM_DETECT_HEIGHT ; hit = D > l ~~~ `l` will have underflowed if q < P ~~~ l > D when q < P
	jr nc, .item_miss_y
	inc hl

	; X
	ld a, c :: sub [hl] :: add MAP_ITEM_DETECT_OFFSET_X
	cp MAP_ITEM_DETECT_WIDTH
	jr nc, .item_miss_x
	inc hl

	; Hit! Increment the results pointer to keep this item ID as a result.
	assert low(wMapQueryResult.items_end) == 0
	; Because low(.items_end) == 0, we only need to increment the low address byte.
	; This allows us to detect the end of the results buffer with F.Z.
	inc e
	jr nz, .continue
	; At capacity.
	ret

.item_miss_y:
	inc hl ; item.y
.item_miss_x:
	inc hl ; item.x
.continue:
	inc hl ; item.type
	jr .loop_items
.end:
	; Terminate results array
	ld a, MAP_ITEM_NULL
	ld [de], a
	ret


;; Perform the chunk elements/zone query.
;; @param HL: chunk.elements
;; @param B,C: Y,X query point local to chunk
;; @mut: AF, DE, HL
_do_zone_query:
	ld a, [hl+] :: ld e, a ; elements array length
	and a
	jr z, .exit_miss
.loop_elements:
	; filter ChunkZone type
	ld a, [hl+] ; .typeid.0
	inc hl ; skip typeid.1
	cp MapObject_CHUNK_ZONE
	jr nz, .err_unexpected_typeid
		push hl ; stash element pointer
	; Y
	; rel = p - min; rel < 0 ? miss
	ld a, b :: sub [hl] :: jr c, .continue_elements
	inc hl
	; rel >= size ? miss
	cp [hl] :: jr nc, .continue_elements ; compare relative point in zone with size
	inc hl

	; X
	ld a, c :: sub [hl] :: jr c, .continue_elements
	inc hl
	cp [hl] :: jr nc, .continue_elements
	inc hl

	; hit
	ld de, wMapQueryResult.zone_rules
	ld a, [hl+] :: ld [de], a :: inc de
	ld a, [hl+] :: ld [de], a

		pop af ; discard stashed element pointer
	ret

.continue_elements:
		pop hl ; element
	ld a, szChunkZone
	add l :: ld l, a
	adc h :: sub l :: ld h, a

	dec e
	jr nz, .loop_elements
.exit_miss:
	ld hl, wMapQueryResult.zone_rules
	ld a, $FF
	ld [hl+], a
	ld [hl+], a
	ret

.err_unexpected_typeid:
	ld b, b
	jr .err_unexpected_typeid

pops ; MapQueryExecute


pushs "MapQueryReset", rom0
;; Reset/initialise map query state.
;; @mut: AF, C, HL
MapQueryReset::
	assert MAP_ITEM_NULL == $FF
	ld a, $FF
	ld c, sizeof("wMapQuery")
	ld hl, startof("wMapQuery")
	jp MemFillSmall

pops ; MapQueryReset


pushs "MapQueryCell", rom0
;; Look up a BG map buffer cell via grid coordinates.
;; @param D,E: Y,X grid coord (will be forced to bgmap dimensions: 32x32)
;; @ret A: CHR ID in the cell
;; @ret HL: pointer to the cell in wMapBgChr
;; @mut: AF, HL
MapQueryCell::
	; Y * 32
	ld a, d
	and $1F ; mod 32
	add a :: add a :: add a ; Y * 8
	ld l, a
	ld h, 0
	add hl, hl :: add hl, hl ; * 32
	; (Y * 32) + X
	ld a, e
	and $1F ; mod 32
	add l :: ld l, a
	adc h :: sub l
	; index buffer
	add high(wMapBgChr)
	ld h, a
	ld a, [hl]
	ret

pops ; MapQueryCell

