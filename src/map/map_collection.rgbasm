include "map.rgbinc"
include "hardware.inc"
include "banker.rgbinc"
include "quest/quest.rgbinc"


pushs "MapCollectionOpen", rom0
;; Load or initialise a working copy of a map's collection state.
;; The collection will be accessible at wMapCollection.
;; BANKNOTE: Caller must ensure Map data bank is accessible.
;; @param HL: Map
;; @mut: AF, BC, DE, HL
MapCollectionOpen::
	; NOTE: Load state not implemented! Completely re-initialises collection.
	; trash items
	ld bc, MapHeader_info
	add hl, bc
	ld a, [hl+] :: ld h, [hl] :: ld l, a ; read info pointer
	; trash_item_count
	ld bc, MapInfo_trash_item_count
	add hl, bc
	ld c, [hl] ; trash_item_count
		wrambpush bank(wScenarioCollectables)
	ld hl, wScenarioCollectables
	ld a, c :: ld [hl+], a ; .size
	ld a, Collectable_READY
	call MemFillSmall
		wrambpop ; wScenarioCollectables
	ret

pops ; MapCollectionOpen


pushs "MapCollectionTrashQuery", rom0
;; @param B: query item id
;; @ret F.C: query success
;; @mut: AF, BC, DE, HL
MapCollectionTrashQuery::
		wrambpush bank(wScenarioCollectables)
	ld hl, wScenarioCollectables
	ld a, [hl+] :: ld c, a ; .size
	ld a, b
	cp c
	ret nc ; query item ID >= collection size
	assert low(wScenarioCollectables.items) == 0
	ld l, b
	ld a, [hl]
		wrambpop ; wScenarioCollectables
	ret

pops ; MapCollectionTrashQuery

