if !def(Q_MAP_INC_rJ398bhW)
def Q_MAP_INC_rJ398bhW equ 1

include "st.rgbinc"


rsreset
;; Terminates the brushes array.
def BR_TERM rb 1

;; { BR_SOLID, reps: db, value: db }
;; Emit `value` `reps+1` times.
def BR_SOLID rb 1

def BR__MAX rb 0
def BR__TYPE equ (1 << bitwidth(BR__MAX)) - 1

rsreset
def MapHeader_chunk_table rb 2
def MapHeader_objects rb 2
def szMapHeader rb 0


rsreset
def MapObject_typeid rb 2
def MapObject_y rb 2
def MapObject_x rb 2
def szMapObject rb 0


rsreset
;; Start of Item ID range
def MapObject_ITEM_ID rb 64
;; End of Item ID range
def MapObject_ITEM_ID_MAX rb 0
def MapObject_PLAYER_START rb 1
;; Flow zone rules
def MapObject_FLOW_RULES rb 1
;; A Zone local to a chunk
def MapObject_CHUNK_ZONE rb 1
def MapObject_NULL equ $FF


;; A Zone local to a chunk
st ChunkZone
	stf y, 1
	stf h, 1
	stf x, 1
	stf w, 1
	stf rules, 2
st


def PLAYER_START_DEFAULT_Y equ 8 * 6
def PLAYER_START_DEFAULT_X equ 8 * 4


;; Metadata at the top of each Map chunk.
;; Provides pointers for navigating various chunk data.
st MapChunkHeader
	stf brushes0, 2
	stf brushes1, 2
	stf elements, 2
	stf items, 2
st


;; Start address of map runtime state section.
def MAP_RUNTIME_STATE_ADDRESS equ $D000
;; Size of map runtime state section.
def MAP_RUNTIME_STATE_SIZE equ $400


/***************************************
************** MapEntity ***************
***************************************/
rsreset
def MapEntityType_FLOW rb 1
def MapEntityType__COUNT rb 0

rsreset
;; Set while an entity exists in the slot.
def bMapEntityCtl_ACTIVE rb 1
def MapEntityCtl_ACTIVE equ 1 << bMapEntityCtl_ACTIVE

st MapEntitySlot
	;; The entity's type ID (MapEntityType).
	stf type, 1
	;; Status/control flags.
	stf ctl, 1
	;; Pointer to entity type data.
	stf data, 2
st


rsreset
def EffectType_FLOW rb 1
def EffectType__COUNT rb 0

def Effect_TYPE equ $0F
assert EffectType__COUNT - 1 <= Effect_TYPE
def bEffect_ENABLE equ 7
def Effect_ENABLE equ 1 << bEffect_ENABLE

;; Flow effect runtime state.
st FlowState
	;; MapEntityType
	stf type, 1
	;; Delay timer
	stf timer, 1
	;; Pointer to FlowDef data.
	stf flow_def, 2
	;; Current position in sequence.
	stf iseq, 1
	;; Effect type and status flags
	stf effect, 1
	;; Current flow vector, X component.
	stf vx, 1
	;; Current flow vector, Y component.
	stf vy, 1
	;; Number of effect indicator sprites.
	stf sprite_count, 1
	;; Pointer to (first) effect indicator sprite.
	stf sprite, 2
st


;; Number of MapEntitySlots available.
def MAP_ENTITY_SLOTS_LENGTH equ 32


/***************************************
************ Flow Sequence *************
***************************************/

;; Mask the code part of a sequence command
def FlowSeq_CODE equ $30
;; Mask the value part of a sequence command
def FlowSeq_VALUE equ $0F
;; Set the Effect_ENABLE flag
def FlowSeq_ENABLE equ $00
;; Select the flow vector by index
def FlowSeq_VEC equ $10
;; Delay sequence for `x * 16 + 15` ticks
def FlowSeq_DELAY equ $20


/***************************************
******* Doodads (Visual Effects) *******
***************************************/

;; Places a Doodad in the scene.
st DoodadPlace
	;; Select the doodad to place.
	stf doodad, 1
	;; Currently unused. Must be zero.
	stf option, 1
	;; Y position in world dots
	stf posy, 2
	;; X position in world dots
	stf posx, 2
st


;; Enumerate Doodads
rsreset
def Doodad_Flow000 rb 1
def Doodad_Flow045 rb 1
def Doodad_Flow090 rb 1
def Doodad_Flow135 rb 1
def Doodad_Flow180 rb 1
def Doodad_Flow225 rb 1
def Doodad_Flow270 rb 1
def Doodad_Flow315 rb 1


/***************************************
************ Item Placement ************
***************************************/

;; Maximum number of items in a chunk.
def CHUNK_ITEMS_MAX equ 16

;; Header / metadata for chunk items collection.
st ChunkItemsHeader
	;; The start of the ID range allocated to this chunk's items.
	stf id_start, 2
	;; Number of items in the collection.
	stf len, 1
st

;; Place an instance of an item in the scene from within a Chunk.
st ItemPlace
	;; Y position in chunk local dots
	stf posy, 1
	;; X position in chunk local dots
	stf posx, 1
	;; Type of item to place
	stf item, 1
st


endc ; Q_MAP_INC_rJ398bhW

