
pushs "BitmaskTable", rom0, align[3]
;; 8 bit single-bit bitmask lookup table.
BitmaskTable:: db $01, $02, $04, $08, $10, $20, $40, $80

pops ; BitmaskTable


pushs "ClampS8", rom0
;; @param B: Value
;; @param E: signed upper bound xored with $80
;; @param D: signed lower bound xored with $80
;; @ret B: Result
;; @mut: AF, B
ClampS8::
	ld a, b :: xor $80 :: ld b, a
	ld a, d
	cp b
	jr nc, .end ; clamp to lower bound

	ld a, e
	cp b
	jr c, .end ; clamp to upper bound

	ld a, b ; in range, keep value
.end
	xor $80
	ld b, a
	ret

pops ; ClampS8


pushs "AddS8_sat", rom0
;; Saturating addition of signed integers. Compute B + C.
;; Result clamped to [-127..127].
;; @param B,C: operands (signed int)
;; @ret C: result
;; @mut: AF, C
AddS8_sat::
	ld a, c :: add b :: ld c, a

	sub b :: xor b :: rlca
	jr c, .end ; operands have opposite signs
	ld a, b :: xor c :: rlca
	jr nc, .end ; result has same sign as operands

	; saturate
	ld a, b :: rlca :: sbc a :: or 1 ; $FF if neg else $01
	; $FF ^ $7E ---> $81
	; $01 ^ $7E ---> $7F
	xor $7E
	ld c, a
	ret
.end
	ld a, c
	cp $80
	ret nz
	inc c
	ret

pops ; AddS8_sat


pushs "AbsS8", rom0
;; Returns absolute value of x, clamped to [0..127].
;; @param A: x
;; @ret A: x if x >= 0 or 127 if x == -128 or -x
;; @mut: AF
AbsS8::
	cp $80
	ret c
	jr nz, :+
	dec a
	ret
:
	cpl :: inc a
	ret

pops ; AbsS8


pushs "AbsS16", rom0
;; Calculate the absolute value of the signed 16 bit integer in BC.
;; @param BC: input
;; @ret BC: abs(input)
;; @mut: AF, BC
AbsS16::
	bit 7, b
	ret z
	ld a, c :: cpl :: ld c, a
	ld a, b :: cpl :: ld b, a
	inc bc
	ret

pops ; AbsS16


if def(TESTS)
pushs "test#AbsS16", rom0
test#AbsS16::
	ld b, b
	call test#AbsS16_neg
	ld b, b
	call test#AbsS16_pos
	ld b, b
	ret


test#AbsS16_neg:
	ld hl, $8000 ; input
	ld de, $8000 ; expect
.loop:
	ld c, l :: ld b, h
	call AbsS16
	ld a, c :: cp e :: jr z, :+
	ld b, b
	jr .continue
:
	ld a, b :: cp d :: jr z, :+
	ld b, b
:
.continue:
	ld a, l :: or h :: ret z
	inc hl
	dec de
	jr .loop



test#AbsS16_pos:
	ld hl, $7FFF ; input
.loop:
	ld c, l :: ld b, h
	call AbsS16
	; expect = input
	ld a, c :: cp l :: jr z, :+
	ld b, b
	jr .continue
:
	ld a, b :: cp h :: jr z, :+
	ld b, b
:
.continue:
	ld a, l :: or h :: ret z
	dec hl
	jr .loop
	ret

pops ; test#AbsS16

endc ; TESTS

