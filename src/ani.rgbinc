if !def(Q_ANI_INC_e6pWgwvG)
def Q_ANI_INC_e6pWgwvG equ 1

include "st.rgbinc"


;; Ani instance struct
st Ani
	;; Frame timer
	stf Ani_timer, 1
	;; ROM bank containing Ani frame data.
	stf Ani_bank, 1
	;; Pointer to current frame data
	stf Ani_frame, 2
	;; Pointer to next frame
	stf Ani_next, 2
st


st AniFrameHeader
	;; Duration of the frame in ticks.
	stf duration, 1
	;; Pointer to next frame.
	stf next, 2
st


;; ani_frame DURATION, NEXT
;; Create a new frame
macro ani_frame
	assert fail, _NARG == 2
	db (\1)
	dw (\2)
endm


endc ; Q_ANI_INC_e6pWgwvG

