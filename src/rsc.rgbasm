include "rsc.rgbinc"
include "banker.rgbinc"
include "hardware.inc"


;; jump_switch BRANCH0, BRANCH1, ...
;; Inline jump table taking branch index from the A register.
macro jump_switch
	cp _NARG
	jr nc, .err_jump_index_out_of_range\@
	rst RST_SwitchJump
	rept _NARG
		dw (\1)
		shift
	endr
.err_jump_index_out_of_range\@
	ld b, b
	jr @-3
endm


;; rsc_type_switch [PREFIX=.impl_]
;; Inline jump table with a branch for each RSC type.
;; The branch is selected using the value of wRscLoader.rsc_type.
;; The label for each branch destination must exist in the form `{PREFIX}{TYPE}`.
macro rsc_type_switch
	if _NARG == 0
		def prefix\@ equs ".impl_"
	else
		def prefix\@ equs "\1"
	endc

	ld a, [wRscLoader.rsc_type]
	and RSC_TYPE
		jump_switch {prefix\@}chr, {prefix\@}pal

	purge prefix\@
endm


pushs "RscStatInit", rom0
RscStatInit::
		wrambpush bank("wRscStat")
	ld hl, startof("wRscStat")
	ld bc, sizeof("wRscStat")
	ld a, $80
	call MemFillLarge
		wrambpop ; wRscStat
	ret

pops ; RscStatInit


pushs fragment "wRscStat", wramx
;; RscLoader state/cache variables
wRscLoader:
	.rsc_type: db
	.rsc_stat: dw
	.rsc_unit_len: db

	;; Rsc code program counter
	.code: dw

	;; space for type impl's use
	.impl_use:
union
	.dest: dw
nextu
	;; one of the PalettePalLoad* functions
	.fn_pal_load: dw
endu
	def szRscLoader_impl_use equ @ - .impl_use

pops ; wRscStat


pushs "RscLoad", rom0
;; Make Rsc available for use.
;; @param DE: Rsc
;; @mut: AF, BC, DE, HL
RscLoad::
		rombpush bank("RscTable")
		wrambpush bank("wRscStat")

	; copy RscHeader
	ld hl, wRscLoader.rsc_type
	; .rsc_type
	ld a, [de] :: inc de :: ld [hl+], a
	; .rsc_stat
	ld a, [de] :: inc de :: ld c, a :: ld [hl+], a
	ld a, [de] :: inc de :: ld b, a :: ld [hl+], a
	; .rsc_unit_len
	ld a, [de] :: inc de :: ld [hl+], a

	; Check stat: bit 7 set indicates rsc not loaded
	ld a, [bc]
	bit 7, a
	jr z, .tail ; early out if already loaded

	; initialise code program counter
	ld a, e :: ld [hl+], a
	ld a, d :: ld [hl+], a

	; reset .impl_use variables
	xor a
	ld c, szRscLoader_impl_use
:
	ld [hl+], a
	dec c
	jr nz, :-

	call RscPreload
	call RscDoCode

.tail:
		wrambpop ; wRscStat
		rombpop ; RscTable
	ret

pops ; RscLoad


pushs "RscPreload", rom0
RscPreload:
	rsc_type_switch

.impl_chr:
	; allocate upfront to get a contiguous block
	ld a, [wRscLoader.rsc_type] :: and RSC_USAGE :: ld b, a
	ld a, [wRscLoader.rsc_unit_len] :: ld c, a
	call _chr_alloc_usage
	jr nc, :+
	ld b, b
	jr @-3
:
	; cache destination address
	ld a, h :: ld [wRscLoader.dest + 1], a
	ld a, l :: ld [wRscLoader.dest + 0], a
	; update stat
	ld hl, wRscLoader.rsc_stat
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	; Get VRAM bank from alloc addr bit 0.
	ld a, [wRscLoader.dest + 0]
	rra :: sbc a :: and $08
	ld [hl+], a
	; chri
	ld a, b :: ld [hl+], a
	ret

.impl_pal:
	; Select .fn_pal_load function to match the rsc USAGE flags -- OB or BG.
	ld de, PalettePalLoadBg
	ld a, [wRscLoader.rsc_type]
	and RSC_USAGE
	assert RSC_USAGE_BG == 0
	jr z, :+
	ld de, PalettePalLoadOb
:
	ld hl, wRscLoader.fn_pal_load
	ld a, e :: ld [hl+], a
	ld a, d :: ld [hl+], a
	ret


;; @param C: alloc length in CHRs
;; @param B: rsc usage
_chr_alloc_usage:
	ld a, b
	swap a
	assert RSC_USAGE_BG == 0
	and a
	jp z, ChrmanAllocBg_not_impl
	dec a
	jp z, ChrmanAllocOb
.err:
	ld b, b
	jr @-3


ChrmanAllocBg_not_impl:
	ld b, b
	jr @-3

pops ; RscPreload


pushs "RscDoCode", rom0
RscDoCode:
	; Return to the top of this routine from jump table to build a loop.
	ld hl, RscDoCode
		push hl

	ld hl, wRscLoader.code
	; read the code ID (first byte of the code)
	ld a, [hl+] :: ld e, a :: ld d, [hl]
	ld a, [de] :: inc de :: ld c, a
	ld a, d :: ld [hl-], a :: ld [hl], e
	ld a, c
	; jump to the impl for this code ID
	jump_switch _do_load, .end

;; Process `END` code
.end:
	; Break the DoCode loop by discarding the looping return address.
		pop af
	ret

;; Process `LOAD` code
_do_load:
	; get code pointer
	ld hl, wRscLoader.code
	ld a, [hl+] :: ld h, [hl] :: ld l, a
	; srcbk
	ld a, [hl+] :: ld b, a
	; src
	ld a, [hl+] :: ld e, a
	ld a, [hl+] :: ld d, a
	; len
	ld a, [hl+] :: ld c, a
	; store updated code pointer
	ld a, l :: ld [wRscLoader.code + 0], a
	ld a, h :: ld [wRscLoader.code + 1], a

	rsc_type_switch

.impl_chr:
	ld hl, wRscLoader.dest
	ld a, [hl+] :: ld h, [hl] :: ld l, a

		push hl :: push bc
	dec c ; len - 1
	call VxLoadRom
		pop bc :: pop hl

	; dest += len * 16
	ld a, c
	swap a
	ld b, a
	and $F0 :: ld c, a
	xor b :: ld b, a
	add hl, bc
	; store updated dest address
	ld a, l :: ld [wRscLoader.dest + 0], a
	ld a, h :: ld [wRscLoader.dest + 1], a
	ret

.impl_pal:
	; the whole rsc code was read above, so we can change bank to the source data safely
		rombpush b
	ld hl, wRscLoader.rsc_stat
	ld a, [hl+] :: ld h, [hl] :: ld l, a
.pal_loop
		push bc
		push hl ; stat
	ld hl, wRscLoader.fn_pal_load
	rst RST_CallPtrPtr
		pop hl ; stat
	; store first palette index
	bit 7, [hl]
	jr z, :+
	ld a, b :: and $07
	ld [hl], a
:
		pop bc
	dec c
	jr nz, :-
		rombpop
	ret

pops ; RscDoCode

