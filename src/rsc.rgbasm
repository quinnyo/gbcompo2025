;; @param DE: Rsc
RscLoadPal::
	ret

	; ld b, bank(WaterEffects_pal)
	; ld de, WaterEffects_pal
	; call PalettePalLoadObRomx
	; ld a, b :: and $07 :: ld [wWaterEffectsPal0], a

pops ; RscLoadPal

