include "hardware.inc"
include "sim/entity.rgbinc"
include "coord.rgbinc"
include "vis/diver.rgbinc"
include "banker.rgbinc"
include "game/action.rgbinc"
include "vis/widgets.rgbinc"


def KEY_JET equ PADF_B
def KEY_CLAW equ PADF_A | PADF_B
def KEY_GRIP equ PADF_A

def KEYS_ACTION equ PADF_A | PADF_B | PADF_START | PADF_SELECT


rsreset
def bInput_DASH rb 1
def bInput_SWEEP rb 1
def bInput_CLAW rb 1
def bInput_GRIP rb 1
; def bInput_CRUSH rb 1
; def bInput_COMPACT rb 1
; def bInput_ANCHOR rb 1
; def bInput_CARRY rb 1


def Input_DASH    equ 1 << bInput_DASH
def Input_SWEEP   equ 1 << bInput_SWEEP
def Input_CLAW    equ 1 << bInput_CLAW
def Input_GRIP    equ 1 << bInput_GRIP
; def Input_CRUSH   equ 1 << bInput_CRUSH
; def Input_COMPACT equ 1 << bInput_COMPACT
; def Input_ANCHOR  equ 1 << bInput_ANCHOR
; def Input_CARRY   equ 1 << bInput_CARRY

def Input_JET equ Input_DASH | Input_SWEEP


;; Taps sampling interval.
def TAPS_WINDOW equ 30
;; Required number of taps to be considered "rapid", within a window.
def TAPS_THRESHOLD equ 3
;; Number of excess taps to be stored in reserve.
def TAPS_RESERVE_MAX equ 5


;; Ticks between applying drive/accel.
def DRIVE_INTERVAL equ 26
;; The default, minimum drive rate
def DRIVE_RATE_MIN equ 9
;; The target drive rate when dashing
def DRIVE_RATE_DASH equ 14


;; The default drive vecdir magnitude.
def VECDIR_MAG_DEFAULT equ (5 << 8) | 7
;; The drive vecdir magnitude during dashing.
def VECDIR_MAG_DASH equ (12 << 8) | 17


;; Distance from anchor point that spring force will begin being applied.
def ANCHOR_SPRING_DIST_MIN equ 3
;; Maximum distance diver can be from the anchor point.
;; If this is exceeded, the anchor action is cancelled.
def ANCHOR_DISTANCE_MAX equ 18
; Number of times to shift spring strength right to calculate spring accel.
def ANCHOR_SPRING_SCALE_SHIFT equ 2


;; Max. number of ActionTrigger requests that can be buffered at once.
def ACTION_REQS_MAX equ 4
;; Duration of action trigger request lockout in ticks
def ACTION_REQ_LOCKOUT equ 15


rsreset
def Player_vis rb szVisDiver
def szPlayer rb 0
assert szPlayer <= szEntityUsr0, "Player struct exceeds Entity Usr0 allocation. ({d:szPlayer} > {d:szEntityUsr0})"


pushs "wPlayerAction", wram0
wPlayerAction:
	.type: db
	.state: db
union
	.anchor_x: dw
	.anchor_y: dw
endu

pops


section "wPlayer", wram0
wPlayer::
	;; Direct directional movement vector, Y axis
	.driveY: db
	;; 'Drive' movement control vector, X axis
	.driveX: db
	;; Entity index
	.ent:: db
	.inputDir: db
	.input: db
	.driveRate: db
	.driveTimer: db

	.vecdir_mag: dw

	.taps_jet: db
	.taps_window: db

	.action_reqs_len: db
	.action_reqs: ds ACTION_REQS_MAX
	;; Action lockout timer -- prevent triggering actions for cooldown period.
	.action_req_lockout: db


section "Player", rom0
PlayerInit::
	ld a, $FF
	ld [wPlayer.ent], a
	ret


;; @param A: player entity index
;; @param BC: Y position
;; @param DE: X position
;; @mut: AF, BC, DE, HL
PlayerSpawn::
	ld [wPlayer.ent], a

	ld hl, wPlayerAction.type
	ld a, ActionType_NULL :: ld [hl+], a
	ld c, sizeof("wPlayerAction") - 1
	xor a
	call MemFillSmall

	call _PlayerClearActReqs

	xor a
	ld [wPlayer.action_req_lockout], a
	ld [wPlayer.driveY], a
	ld [wPlayer.driveX], a
	ld [wPlayer.inputDir], a
	ld [wPlayer.input], a
	ld a, DRIVE_RATE_MIN :: ld [wPlayer.driveRate], a
	ld a, DRIVE_INTERVAL
	ld [wPlayer.driveTimer], a
	ld a, low(VECDIR_MAG_DEFAULT) :: ld [wPlayer.vecdir_mag + 0], a
	ld a, high(VECDIR_MAG_DEFAULT) :: ld [wPlayer.vecdir_mag + 1], a

	xor a :: ld [wPlayer.taps_jet], a
	ld a, TAPS_WINDOW :: ld [wPlayer.taps_window], a

	ld a, [wPlayer.ent]
	call EntityAt

	ld a, ENTINFOF_OCCUPIED | ENTINFOF_ALIVE | $01
	ld [hl+], a
	ld a, ENTCTRL_DRAG_A
	ld [hl+], a

	xor a
	ld [hl+], a ; accx
	ld [hl+], a ; velx
	ld a, e :: ld [hl+], a ; posx.lo
	ld a, d :: ld [hl+], a ; posx.hi
	xor a
	ld [hl+], a ; accy
	ld [hl+], a ; vely
	ld a, c :: ld [hl+], a ; posy.lo
	ld a, b :: ld [hl+], a ; posy.hi

	; FnUpdate impl
	ld de, EntityFnUpdateMoveCollide
	ld b, bank(EntityFnUpdateMoveCollide)
	ld a, [wPlayer.ent]
	call EntitySetFnUpdate

	; FnThink impl
	ld de, PlayerThink
	ld b, bank(PlayerThink)
	ld a, [wPlayer.ent]
	call EntitySetFnThink

	; FnRender impl
	ld de, PlayerRender
	ld b, bank(PlayerRender)
	ld a, [wPlayer.ent]
	call EntitySetFnRender

	; vis struct in Usr0
	ld a, [wPlayer.ent]
	call EntityGetUsr0
		wrambpush bank(wEntityUsr0)
	assert Player_vis == 0
	call VisDiverReset
		wrambpop

	ret


;; Entity impl FnThink for player entity controller.
;; @mut: AF, BC, D, HL
PlayerThink:
if def(DEBUG_ANCHOR)
	; [DEBUG] anchor point detect
	call Player_DetectAnchorTarget
	jr nc, :+
		push de
	ld a, [wScroll.y + 0] :: ld e, a
	ld a, [wScroll.y + 1] :: ld d, a
	ld a, c :: sub e
	add 12 :: ld h, a ; display Y
		pop bc
	ld a, [wScroll.x + 0] :: ld e, a
	ld a, [wScroll.x + 1] :: ld d, a
	ld a, c :: sub e
	add 4 :: ld c, a ; X
	ld b, h ; Y

	ld e, WIDGET_SPIN
	call WidgetRender
:
endc ; DEBUG_ANCHOR

	; Clear requests
	xor a :: ld [wPlayer.action_reqs_len], a

	; Do each InputAction update routine & if a valid ActionTrigger request
	; was returned, add it to the pool of candidates.

	call _PlayerInput_claw
	ld a, b
	cp szActionTrigger
	call c, _PlayerAddActReq

	call _PlayerInput_grip
	ld a, b
	cp szActionTrigger
	call c, _PlayerAddActReq

	; Do JET last ~~> should not override others.
	call _PlayerInput_jet
	ld a, b
	cp szActionTrigger
	call c, _PlayerAddActReq

	; Process ActionTrigger requests
	call _PlayerProcessActReqs
	; Process active action
	call _PlayerActionUpdate

	ldh a, [hKeys]
	and $F0
	ld [wPlayer.inputDir], a

	; Compute driveTimer delta from driveRate. Increment B to ensure delta > 0
	ld hl, wPlayer.driveRate
	ld a, [hl]
	; Clamp to DRIVE_INTERVAL - 1
	cp DRIVE_INTERVAL
	jr c, :+
	ld a, DRIVE_INTERVAL - 1
:
	ld b, a; :: inc b
	inc hl
	ld a, [hl] ; driveTimer
	sub b
	ld [hl], a
	ret nc

	; Reset timer
	ld a, DRIVE_INTERVAL
	ld [hl-], a ; driveTimer

	; Drain boost
	ld a, [hl]
	cp DRIVE_RATE_MIN
	jr z, .drain_boost_done
	jr c, :+
	; boost > min
	dec [hl]
	jr .drain_boost_done
:
	ld a, DRIVE_RATE_MIN
	ld [hl], a
.drain_boost_done:

	; Drain vecdir magnitude & load it to DE
	ld hl, wPlayer.vecdir_mag
	ld e, [hl]
	ld a, low(VECDIR_MAG_DEFAULT)
	cp e
	jr nc, :+
	dec [hl]
:
	inc hl
	ld d, [hl]
	ld a, high(VECDIR_MAG_DEFAULT)
	cp d
	jr nc, :+
	dec [hl]
:

	; update drive vector
	ld a, [wPlayer.inputDir] :: ld b, a
	call Vecdir8FromKeys
	ld a, d :: ld [wPlayer.driveY], a
	ld a, e :: ld [wPlayer.driveX], a

	; get entity pointer
	ldh a, [hEntityActive.state + 0] :: ld l, a
	ldh a, [hEntityActive.state + 1] :: ld h, a
	entity_index Entity_AccY
	ld b, d :: ld c, [hl]
	call AddS8_sat
	ld [hl], c
	entity_index Entity_AccX
	ld b, e :: ld c, [hl]
	call AddS8_sat
	ld [hl], c

	entity_index Entity_Ctrl
	; set NOGRAV if active directional input.
	res bENTCTRL_NOGRAV, [hl]
	ld a, e :: or d
	jr z, :+
	set bENTCTRL_NOGRAV, [hl]
:

	ret


PlayerRender:
	; get entity pointer
	ldh a, [hEntityActive.state + 0] :: ld l, a
	ldh a, [hEntityActive.state + 1] :: ld h, a

	; After scrolling, adjust display position
	entity_index Entity_DispX
	ld a, [hl+] :: ld c, a
	ldh a, [hScrollAppliedX]
	cpl :: inc a :: add c :: add ENT_SPRITE_X_OFF :: ld c, a
	assert Entity_DispY == Entity_DispX + 1
	ld a, [hl+] :: ld b, a
	ldh a, [hScrollAppliedY]
	cpl :: inc a :: add b :: add ENT_SPRITE_Y_OFF :: ld b, a

		push bc

	; Update vis ctl speed
	ld b, 0
	ld a, [wPlayer.driveY]
	ld c, a
	ld a, [wPlayer.driveX]
	or c
	jr z, .nodrive
	entity_index Entity_VelY
	ld a, [hl]
	call AbsS8
	ld b, a
	entity_index Entity_VelX
	ld a, [hl]
	call AbsS8
	or b
	srl a
	cp VisDiverCtl_SPEED+1
	jr c, :+
	ld a, VisDiverCtl_SPEED
:
	ld b, a
.nodrive
	; player.vis (in entity usr0)
	ldh a, [hEntityActive.usr0 + 0] :: ld l, a
	ldh a, [hEntityActive.usr0 + 1] :: ld h, a

	; ctl.HEADING
	ldh a, [hKeys]
	and VisDiverCtl_HEADING
	or b
	call VisDiverSetCtl

		pop bc

	ldh a, [hEntityActive.usr0 + 0] :: ld l, a
	ldh a, [hEntityActive.usr0 + 1] :: ld h, a
	; update position
	ld a, b :: ld [hl+], a
	ld a, c :: ld [hl-], a
	; update/display
	jp VisDiverUpdate


PlayerViewTarget::
	ld a, [wPlayer.ent]
	call EntityAt
	ret nc

	; player entity Y position
	entity_index Entity_PosY
	ld a, [hl+] :: ld c, a
	ld a, [hl+] :: ld b, a
	coord_int16 bc

	; view rect centre
	ld a, [wScroll.y + 0]
	add 144 / 2 :: ld e, a
	ld a, [wScroll.y + 1]
	adc e :: sub e :: ld d, a

	coord_sub bc, de
	entity_index Entity_DispY
	ld a, c :: add 144 / 2 :: ld [hl], a
	call _ScrollFenceThing
	ld [wScroll.dy], a

	; player entity X position
	entity_index Entity_PosX
	ld a, [hl+] :: ld c, a
	ld a, [hl+] :: ld b, a
	coord_int16 bc

	; view rect centre
	ld a, [wScroll.x + 0]
	add 160 / 2 :: ld e, a
	ld a, [wScroll.x + 1]
	adc e :: sub e :: ld d, a

	coord_sub bc, de
	entity_index Entity_DispX
	ld a, c :: add 160 / 2 :: ld [hl], a
	call _ScrollFenceThing
	ld [wScroll.dx], a

	ret


;; Scroll view if target is more than this distance from the screen centre.
def SCROLL_FENCE equ 4


;; @param C: dCentre -- target position relative to view centre
;; @ret A: scroll delta
_ScrollFenceThing:
	ld a, c
	and a
	ret z
	rlca
	jr c, .negative
.positive
	ld a, c
	sub SCROLL_FENCE
	ret nc
	xor a
	ret
.negative
	ld a, c
	sub -SCROLL_FENCE
	ret c
	xor a
	ret


;; Clear and erase the contents of the action requests buffer.
;; @mut: AF, C, HL
_PlayerClearActReqs:
	ld hl, wPlayer.action_reqs_len
	xor a :: ld [hl+], a
	ld c, ACTION_REQS_MAX
	ld a, ActionTrigger_NULL
	jp MemFillSmall


;; Add an ActionTrigger request to the requests buffer.
;; @param B: request (ActionTrigger)
;; @mut: AF, HL
_PlayerAddActReq:
	ld hl, wPlayer.action_reqs_len
	; Bounds check
	ld a, [hl]
	cp ACTION_REQS_MAX
	ret nc
	inc a
	; Pre-incremented len, so use &len (&buffer - 1) as the base address.
	ld [hl], a ; (don't advance HL)
	; Index into buffer
	add l :: ld l, a
	adc h :: sub l :: ld h, a
	; Write new request value
	ld [hl], b
	ret


;; Process the buffered ActionTrigger requests
;; @mut: AF, C, DE, HL
_PlayerProcessActReqs:
	; Do lockout timer
	ld a, [wPlayer.action_req_lockout]
	and a
	jr z, .proc_reqs
	dec a
	ld [wPlayer.action_req_lockout], a
	jr .flush
.proc_reqs:
	; Process requests
	ld hl, wPlayer.action_reqs_len
	ld a, [hl+]
	and a
	ret z ; list is empty

	ld c, a ; len
	ld a, ACTION_REQ_LOCKOUT :: ld [wPlayer.action_req_lockout], a
.loop:
	ld a, [hl+] ; ActionTrigger
		push hl :: push bc
	call _PlayerResolveActionTrigger
		pop bc :: pop hl

	; check resolved type
	ld a, d
	cp szActionType
	jr c, .flush ; resolved to a valid type, break

	dec c
	jr nz, .loop

.flush:
	; Clear requests
	xor a :: ld [wPlayer.action_reqs_len], a
	ret


;; Process an action trigger request into a new action.
;; Activates new action if successful.
;; @param A: request (ActionTrigger)
;; @param D: current action type
;; @param E: current action state
;; @ret D: resolved type (ActionType)
;; @mut: AF, BC, DE, HL
_PlayerResolveActionTrigger:
	cp szActionTrigger
	jr nc, .err_unexpected
	rst RST_SwitchJump
.jumptab
	dw .trigger_proc_dash
	dw .trigger_proc_sweep
	dw .trigger_proc_claw
	dw .trigger_proc_grip
assert (@ - .jumptab) >> 1 == szActionTrigger

.err_unexpected:
	ld b, b
	ret

.trigger_proc_dash:
	; Resolve into DASH action.
	ld b, ActionType_DASH
	jp _PlayerActionSimple

.trigger_proc_sweep:
	; Resolve into SWEEP action.
	ld b, ActionType_SWEEP
	jp _PlayerActionSimple

.trigger_proc_claw:
	; Try to resolve into CRUSH or COMPACT if a valid target is in range.

	jr .no_change

.trigger_proc_grip:
	; If carryable target detected, do CARRY action.
	; Otherwise, if anchor point detected, do ANCHOR action.

	; If either GRIP action is current active, do nothing.
	call _PlayerGetActionLive
	cp ActionType_CARRY
	jr z, .no_change
	cp ActionType_ANCHOR
	jr z, .no_change

	; CARRY
	; call Player_DetectCarryTarget

	; ANCHOR
	call Player_DetectAnchorTarget
	jr nc, .no_change
	ld hl, wPlayerAction.type
	ld a, ActionType_ANCHOR :: ld [hl+], a ; .type
	ld a, ActionState_NEW :: ld [hl+], a ; .state
	ld a, e :: ld [hl+], a ; .anchor_x
	ld a, d :: ld [hl+], a
	ld a, c :: ld [hl+], a ; .anchor_y
	ld a, b :: ld [hl+], a
	ld d, ActionType_ANCHOR ; return resolved action type
	ret
.no_change:
	ld d, ActionType_NULL
	ret


;; Get the player's current live action, if any.
;; Returns ActionType_NULL if current action is not live.
;; @ret A: current live action type
;; @ret F.Z: set if no live action
;; @mut: AF
_PlayerGetActionLive:
	ld a, [wPlayerAction.state]
	and ActionState_LIVE
	ld a, ActionType_NULL
	ret z
	ld a, [wPlayerAction.type]
	ret


;; Initialise a new (simple) action with the given type.
;; If the current action is of the same type and is active, do nothing.
;; @param B: resolve into ActionType
;; @param D: current action type
;; @param E: current action state
;; @ret D: resolved action type
;; @ret HL: @action.ext (only valid with F.C)
;; @ret F.C: success -- set if initialising new action
;; @mut: AF, D, HL
_PlayerActionSimple:
	ld a, e
	and ActionState_LIVE
	jr z, :+
	ld a, d
	cp b
	ret z ; current action is active & same type: do nothing.
:
	; initialise new action
	ld d, b
	ld hl, wPlayerAction.type
	ld a, d :: ld [hl+], a ; type
	ld a, ActionState_NEW :: ld [hl+], a ; state
	scf
	ret


;; Cancel the current action
;; @mut: AF
_PlayerCancelAction:
	ld a, [wPlayerAction.state]
	and ~ActionState_LIVE
	ld [wPlayerAction.state], a

	ld a, ACTION_REQ_LOCKOUT :: ld [wPlayer.action_req_lockout], a
	ret


_PlayerActionUpdate:
	ld a, [wPlayerAction.state]
	and ActionState_LIVE
	ret z
	ld de, wPlayerAction.type
	ld a, [de] :: inc de ; type
	cp szActionType
	ret nc
	rst RST_SwitchJump
.jump_table:
	dw _act_jet
	dw _act_claw
	dw _act_grip
	dw _act_dash
	dw _act_sweep
	dw _act_crush
	dw _act_compact
	dw _act_anchor
	dw _act_carry
assert (@ - .jump_table) >> 1 == szActionType

_act_jet:
	ld b, b
	ret

_act_claw:
	ld b, b
	ret

_act_grip:
	ld b, b
	ret

_act_dash:
	; Cancel dash if input flag not set.
	ld a, [wPlayer.input]
	bit bInput_DASH, a
	jp z, _PlayerCancelAction

	; Do first-time setup if NEW
	ld a, [de]
	bit bActionState_NEW, a
	jr z, :+
	; clear NEW flag, enter ACTIVE state
	res bActionState_NEW, a
	set bActionState_ACTIVE, a
	ld [de], a
:

	; Drive vecdir magnitude gain
	ld hl, wPlayer.vecdir_mag
	ld a, [hl]
	cp low(VECDIR_MAG_DASH)
	jr nc, :+
	inc a :: ld [hl+], a
:
	ld a, [hl]
	cp high(VECDIR_MAG_DASH)
	jr nc, :+
	inc a :: ld [hl+], a
:

	; Drive rate gain
	ld a, [wPlayer.driveRate]
	inc a
	cp DRIVE_RATE_DASH + 1
	jr c, :+
	ld a, DRIVE_RATE_DASH
:
	ld [wPlayer.driveRate], a

	ret

_act_sweep:
	; Cancel if input flag not set.
	ld a, [wPlayer.input]
	bit bInput_SWEEP, a
	jp z, _PlayerCancelAction

	ld a, [de]
	res bActionState_NEW, a
	ld [de], a
	ret

_act_crush:
	ld a, [de]
	res bActionState_NEW, a
	ld [de], a
	ret

_act_compact:
	ld a, [de]
	res bActionState_NEW, a
	ld [de], a
	ret

_act_anchor:
	ld a, [de]
	bit bActionState_ACTIVE, a
	jr nz, :+
	bit bActionState_NEW, a
	ret z
	; clear NEW and set ACTIVE
	xor ActionState_NEW | ActionState_ACTIVE
	ld [de], a
	ret
:
	; If GRIP pressed: release
	ld a, [wPlayer.input]
	bit bInput_GRIP, a
	jp nz, _PlayerCancelAction

	; Process anchor displacement
	ldh a, [hEntityActive.state + 0] :: ld l, a
	ldh a, [hEntityActive.state + 1] :: ld h, a
	entity_index Entity_PosY
	ld a, [hl+] :: ld c, a
	ld a, [hl+] :: ld b, a
	coord_int16 bc
		push bc
	entity_index Entity_PosX
	ld a, [hl+] :: ld e, a
	ld a, [hl+] :: ld d, a
	coord_int16 de
	ld a, [wPlayerAction.anchor_x + 0] :: ld c, a
	ld a, [wPlayerAction.anchor_x + 1] :: ld b, a
	entity_index Entity_AccX
	call _process_anchor_displacement
		pop de ; entity Y
	jp nc, _PlayerCancelAction
	ld a, [wPlayerAction.anchor_y + 0] :: ld c, a
	ld a, [wPlayerAction.anchor_y + 1] :: ld b, a
	entity_index Entity_AccY
	call _process_anchor_displacement
	jp nc, _PlayerCancelAction

	; [DEBUG] Show anchor point
	ld hl, wPlayerAction.anchor_x
	ld a, [hl+] :: ld c, a
	ld a, [hl+] :: ld b, a
	ld a, [wScroll.x + 0] :: ld e, a
	ld a, [wScroll.x + 1] :: ld d, a
	ld a, c :: sub e :: ld c, a
	ld a, b :: sbc d :: ld b, a
		push bc
	ld a, [hl+] :: ld c, a
	ld a, [hl+] :: ld b, a
	ld a, [wScroll.y + 0] :: ld e, a
	ld a, [wScroll.y + 1] :: ld d, a
	ld a, c :: sub e :: ld c, a
	ld a, b :: sbc d :: ld b, a
		pop de ; X
	ld a, c :: add 12 :: ld b, a ; Y
	ld a, e :: add 4 :: ld c, a ; X
	ld a, [wVBlankCount]
	and $F0
	swap a
	assert WIDGET_GRAB_LENGTH == (-WIDGET_GRAB_LENGTH) & WIDGET_GRAB_LENGTH
	and WIDGET_GRAB_LENGTH - 1
	add WIDGET_GRAB
	ld e, a
	jp WidgetRender

_act_carry:
	ld a, [de]
	res bActionState_NEW, a
	ld [de], a
	ret


;; Process anchor displacement (one axis):
;; - Calc displacement, distance
;; - Check anchor break distance threshold
;; - Apply anchor spring acceleration
;; @param BC: p_anchor (unsigned)
;; @param DE: p_diver (unsigned)
;; @param HL: pointer to accel state
;; @ret F.NC: distance exceeds upper bound
;; @mut: AF, BC, DE
_process_anchor_displacement:
	ld a, c :: sub e :: ld c, a
	ld a, b :: sbc d :: ld b, a
	ld d, b ; keep sign of actual difference
	call AbsS16
	; saturate BC ~~> C
	ld a, b :: and a :: jr z, :+
	; B nonzero: set C to maximum
	ld c, $FF
:

	; check max distance
	ld a, c :: cp ANCHOR_DISTANCE_MAX
	ret nc

	; spring return strength
	ld a, c :: sub ANCHOR_SPRING_DIST_MIN
	ret c ; (dist < lower bound): dead zone, no spring back

	; scale spring response
	rept ANCHOR_SPRING_SCALE_SHIFT
		sra c
	endr
	inc c ; ensure strength is non-zero

	; calc spring accel toward anchor point
	bit 7, d
	jr z, :+
	xor a :: sub c :: ld c, a
:

	; apply accel
	ld b, [hl]
	call AddS8_sat
	ld [hl], c

	scf
	ret


;; Update input state for JET abilities
;; @ret B: requested action (ActionTrigger)
;; @mut: AF, BC, HL
_PlayerInput_jet:
	; Load input SWEEP state into C
	ld a, [wPlayer.input]
	and Input_SWEEP :: ld c, a

	; Increment tap counter on JET key press.
	ld hl, wPlayer.taps_jet
	ldh a, [hKeysPressed]
	and KEY_JET
	jr z, :+
	inc [hl]
:
	ld a, [hl+] ; taps_jet
	dec [hl] ; taps_window--
	jr nz, .finalise

	; Window closing -- check tap counter
	ld b, TAPS_WINDOW :: ld [hl], b :: dec hl
	sub TAPS_THRESHOLD
	jr nc, .rapid ; if count >= threshold

	; Reset -- count < threshold
	xor a :: ld [hl+], a ; taps_jet
	ld a, TAPS_WINDOW :: ld [hl], a ; taps_window
	res bInput_SWEEP, c
	jr .finalise

.rapid:
	set bInput_SWEEP, c

	; Keep excess (up to TAPS_RESERVE_MAX) for next window
	cp TAPS_RESERVE_MAX + 1
	jr c, :+
	ld a, TAPS_RESERVE_MAX
:
	ld [hl], a ; taps_jet

.finalise:
	ld b, ActionTrigger_SWEEP
	; DASH & SWEEP are mutually exclusive, SWEEP takes priority.
	; If not SWEEP then set Input_DASH if JET key is down.
	bit bInput_SWEEP, c
	jr nz, :+
	ld b, ActionTrigger_NULL
	ldh a, [hKeys]
	and KEY_JET
	jr z, :+
	ld b, ActionTrigger_DASH
	set bInput_DASH, c
:

	; Store the new JET input state (in C)
	ld hl, wPlayer.input
	ld a, ~Input_JET :: and [hl]
	or c :: ld [hl], a

	ret


;; Update input state for CLAW abilities
;; @ret B: requested action (ActionTrigger)
;; @mut: AF, BC, HL
_PlayerInput_claw:
	ld b, ActionTrigger_NULL

	ld hl, wPlayer.input
	res bInput_CLAW, [hl]

	ld a, [wChord]
	cp KEY_CLAW
	ret nz
	set bInput_CLAW, [hl]
	ld b, ActionTrigger_CLAW
	ret


;; Update input state for GRIP abilities
;; @ret B: requested action (ActionTrigger)
;; @mut: AF, B, HL
_PlayerInput_grip:
	ld b, ActionTrigger_NULL
	ld hl, wPlayer.input
	ldh a, [hKeysPressed]
	cpl
	and KEY_GRIP
	jr z, :+
	res bInput_GRIP, [hl]
	ret
:
	set bInput_GRIP, [hl]
	ld b, ActionTrigger_GRIP
	ret


pushs "Player_DetectCarryTarget", rom0
;; Scan for a carryable target within reach.
;; @ret F.C: set on success
Player_DetectCarryTarget:
	xor a ; clear F.C
	ret

pops ; Player_DetectCarryTarget


pushs "Player_DetectAnchorTarget", rom0
;; Scan for an anchor point within reach.
;; @ret F.C: set on success
;; @ret DE: anchor point X
;; @ret BC: anchor point Y
;; @mut: AF, HL, BC, DE
Player_DetectAnchorTarget:
	ld b, Optid_AnchorAnywhere
	call OptGet
	jr nz, .anchor_anywhere

.scan_bg:
	; Get player grid position
	ldh a, [hEntityActive.state + 0] :: ld l, a
	ldh a, [hEntityActive.state + 1] :: ld h, a
	entity_index Entity_PosX
	; divide by 128: shift 16 bits left once, then take only the high byte
	ld a, [hl+] :: rla
	ld a, [hl+] :: rla
	ld e, a
	entity_index Entity_PosY
	ld a, [hl+] :: rla
	ld a, [hl+] :: rla
	ld d, a

	; HACK: testing for this single (hard-coded) tile (filled/solid).
	ld b, $0A

	; Origin
	call MapQueryCell
	; NOTE: using sub instead of cp so .anchor_tile can use the zero
	sub b :: jr z, .anchor_tile
	; tap Y axis
	ld c, d ; preserve Y origin
	dec d
	call MapQueryCell
	sub b :: jr z, .anchor_tile
	inc d :: inc d
	call MapQueryCell
	sub b :: jr z, .anchor_tile
	ld d, c ; restore Y origin

	; tap X axis
	ld c, e ; preserve X origin
	dec e
	call MapQueryCell
	sub b :: jr z, .anchor_tile
	inc e :: inc e
	call MapQueryCell
	sub b :: jr z, .anchor_tile

.failed:
	and a ; clear F.C
	ret
.anchor_tile:
	; found a tile anchor target ... calc anchor point (dots) from grid coord
	; Y
	ld h, 0 :: ld l, d
	add hl, hl
	inc hl ; (+1) * 4 to centre on tile
	add hl, hl :: add hl, hl
	ld c, l :: ld b, h
	; X
	ld h, 0 :: ld l, e
	add hl, hl
	inc hl ; (+1) * 4 to centre on tile
	add hl, hl :: add hl, hl
	ld e, l :: ld d, h
	scf ; success!
	ret
.anchor_anywhere:
	ldh a, [hEntityActive.state + 0] :: ld l, a
	ldh a, [hEntityActive.state + 1] :: ld h, a

	entity_index Entity_PosX
	ld a, [hl+] :: ld e, a
	ld a, [hl+] :: ld d, a
	coord_int16 de

	entity_index Entity_PosY
	ld a, [hl+] :: ld c, a
	ld a, [hl+] :: ld b, a
	coord_int16 bc

	scf
	ret

pops ; Player_DetectAnchorTarget

