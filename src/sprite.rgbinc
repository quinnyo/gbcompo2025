if !def(Q_SPRITE_INC_3dMG2Z3W)
def Q_SPRITE_INC_3dMG2Z3W equ 1

include "st.rgbinc"
include "ani.rgbinc"


/*
# Managed Sprites: visibility determination, culling

Notes on "visibility" and culling behaviour for SpriteInst/SpritePool.
Logical overview of managed sprite update logic.

- SprxTestVisibilty is used as view culling.
	- Determines if a world point could -- when used as a Sprx render
	  position -- result in any part of the Sprx appearing on the display.
	- View culling should occur as early as possible, to avoid doing unnecessary work.
	- SpriteInsts that are culled (i.e. unlikely to actually appear on screen) are not animated.
- SpriteInst animation should be updated (if enabled) so long as the sprite is not culled.
- The SpriteInst_VISIBLE flag controls visibility (if the sprite should be displayed) **only**.
	- This is checked at the latest possible time, to avoid skipping any other logic.
*/


rsreset
;; Slot is empty
def bSpritePoolSlot_EMPTY rb 1

def SpritePoolSlot_EMPTY equ 1 << bSpritePoolSlot_EMPTY


rsreset
;; Control sprite visibility. Set to show the sprite, clear to hide the sprite.
def bSpriteInst_VISIBLE rb 1
;; Enable animation processing.
;; If clear, no time will be applied to the animation -- it will be "paused".
def bSpriteInst_ANIMATE rb 1

def SpriteInst_VISIBLE equ 1 << bSpriteInst_VISIBLE
def SpriteInst_ANIMATE equ 1 << bSpriteInst_ANIMATE
;; The initial state for all SpriteInst flags.
def SpriteInst_INIT equ 0


;; Animated sprite instance
st SpriteInst
	stf flags, 1
	;; Y position in world dots
	stf posy, 2
	;; X position in world dots
	stf posx, 2
	;; base CHRI index
	stf chri, 1
	;; base ATRB, PAL index
	stf atrb, 1
	;; Ani instance
	stf ani, szAni
	stf _pad, 3
st
assert szSpriteInst == 16


;; Sprob escape code
def bSprob_ESC equ 7
;; Terminates sprite descriptor
def Sprob_END equ $80

;; Sprob coordinates are unsigned values in range [0..64)
def SprobCoordMax equ 64
def SprobOriginY equ 32
def SprobOriginX equ 32


;; sprob_raw Y, X, I, A
macro sprob_raw
	assert fail, _NARG == 4
	assert (\1) >= 0 && (\1) < 64, "sprob Y position out of range. Expected 0 <= (\1) < 64."
	assert (\2) >= 0 && (\2) < 64, "sprob X position out of range. Expected 0 <= (\2) < 64."
	db (\1), (\2), (\3), (\4)
endm


;; sprob Y, X, I, A
macro sprob
	assert fail, _NARG == 4
	sprob_raw SprobOriginY + (\1), SprobOriginX + (\2), (\3), (\4)
endm


;; sprob_opts_reset [opt]
macro sprob_opts_reset
	redef __SPROB_OPTS equ 1
	redef _sprSY equ 0
	redef _sprSX equ 0
	redef _sprSI equ 0

	sprob_opts \#
endm


;; sprob_opts [FLAG], [KEY:VALUE]
macro sprob_opts
	if !def(__SPROB_OPTS)
		sprob_opts_reset
	endc
	rept _NARG
		redef _optSepIdx equ strfind("\<1>", ":")
		if _optSepIdx != -1
			redef _optKey equs strslice("\<1>", 0, _optSepIdx)
			redef _optVal equs strslice("\<1>", _optSepIdx+1)
			if strcmp("{_optKey}", "sy") == 0
				redef _sprSY equ ({_optVal})
			elif strcmp("{_optKey}", "sx") == 0
				redef _sprSX equ ({_optVal})
			elif strcmp("{_optKey}", "si") == 0
				redef _sprSI equ ({_optVal})
			endc
			purge _optKey, _optVal
		else
			fail "Unknown sprob opt {d:I}: '{"\<I>"}'"
		endc
		shift
		purge _optSepIdx
	endr
endm


;; sprob_seq N, Y, X, I, A, [opt]
macro sprob_seq
	assert fail, _NARG >= 5
	def _sprN equ (\1)
	assert fail, _sprN >= 0
	def _sprY equ (\2)
	def _sprX equ (\3)
	def _sprI equ (\4)
	def _sprA equ (\5)
	shift 5

	sprob_opts \#

	rept _sprN
		sprob _sprY, _sprX, _sprI, _sprA
		redef _sprY equ _sprY + _sprSY
		redef _sprX equ _sprX + _sprSX
		redef _sprI equ _sprI + _sprSI
	endr

	purge _sprN, _sprY, _sprX, _sprI, _sprA
endm


macro sprob_end
	assert fail, _NARG == 0
	db Sprob_END
endm


;; sprtab_add2 NAME, SRC, RSC_CHRS, RSC_PALS
macro sprtab_add2
	assert def(@)

	if !def(SPRTAB_COUNT)
		def SPRTAB_COUNT = 0
	endc

	def SPRTAB_{d:SPRTAB_COUNT}_NAME equs "\1"

	\1::
		.reserved: db 0
		.srcbk:: db bank(\2)
		.src:: dw (\2)
		.rsc_chrs:: dw \3
		.rsc_pals:: dw \4

	def SPRTAB_COUNT += 1
endm


;; Generate the table data
macro sprtab_done2
	assert def(SPRTAB_COUNT)

	;; Number of entries in the table
	.size:: db SPRTAB_COUNT
	;; Array of pointers to entries
	.items::
		for I, SPRTAB_COUNT
			dw {SPRTAB_{d:I}_NAME}
		endr
endm


endc ; Q_SPRITE_INC_3dMG2Z3W

