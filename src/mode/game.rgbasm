include "hardware.inc"
include "banker.rgbinc"
include "mode.rgbinc"
include "coord.rgbinc"
include "sim/entity.rgbinc"
include "map/map.rgbinc"


	mode_def modeGamePrep, modeGamePrep_ExtraFuncs
	mode_def modeGame


section "modeGamePrep", romx
modeGamePrep_ExtraFuncs::
	dw _load0
	dw _load1
	dw _load2
	dw _load3
	dw _load4
	dw _done


_load0:
	call ModeLoadWaitVx :: ret nc

	; BG tiles part 1
	ld b, bank("assets/enviro0.chr")
	ld de, startof("assets/enviro0.chr")
	ld c, sizeof("assets/enviro0.chr") / 2 / 16 - 1
	ld hl, $9000
	jp VxLoadRom


_load1:
	call ModeLoadWaitVx :: ret nc

	; BG tiles part 2
	ld b, bank("assets/enviro0.chr")
	ld de, startof("assets/enviro0.chr") + sizeof("assets/enviro0.chr") / 2
	ld c, sizeof("assets/enviro0.chr") / 2 / 16 - 1
	ld hl, $9000 + sizeof("assets/enviro0.chr") / 2
	jp VxLoadRom


_load2:
	call ModeLoadWaitVx :: ret nc

	; BG palettes
	ld de, startof("assets/enviro0.chr.pal")
	ld c, sizeof("assets/enviro0.chr.pal") / 8
	ld b, 0
	ld h, bank("assets/enviro0.chr.pal")
	jp PalettesLoadRomx


_load3:
	call ModeLoadWaitVx :: ret nc

	call PlayerInit
	call CollideInit
	call ItemsInit
	jp TangleInit


_load4:
	call ModeLoadWaitVx :: ret nc

	call MapOpen

	call MapGetPlayerStart
	coord_from_dots16 bc
	coord_from_dots16 de

	xor a ; player entity index
	jp PlayerSpawn


_done:
	call ModeLoadWaitVx :: ret nc

	call MapSyncVisible

	ld a, MODE_STATE_PROCESS :: ldh [hModeState], a
	jp CurtainOpen


modeGamePrep_Enter::
	call ChrmanResetAll
	call SpritePoolInit ; clear sprites
	call VisDiverResourceInit
	call BudEntResourceInit

	call PackInit
	call QuestInit
	call ScrollInit
	call EntityInit

	ld a, MODE_STATE_EXTRA :: ldh [hModeState], a
	ret


modeGamePrep_Process::
	ldh a, [hCurtain]
	bit bCurtain_STEADY, a
	ret z

	ld de, rModes_modeGame
	jp ModeSetActive


section fragment "modeGame", romx
modeGame_Enter::
	call MapViewerInit
	ld a, MODE_STATE_PROCESS :: ldh [hModeState], a
	ret


modeGame_Process::
	call _TestMapZones

	call EntityUpdate
	call _ViewUpdate

	; Configure Map query ~~ Query point is player entity position.
	ld a, [wPlayer.ent]
	call EntityAt
	jr nc, :+
	entity_index Entity_PosX
	ld a, [hl+] :: ld e, a
	ld a, [hl+] :: ld d, a
	coord_int16 de
	entity_index Entity_PosY
	ld a, [hl+] :: ld c, a
	ld a, [hl+] :: ld b, a
	coord_int16 bc
	ld hl, wMapQuery.py
	ld a, c :: ld [hl+], a ; .py[0]
	ld a, b :: ld [hl+], a ; .py[1]
	ld a, e :: ld [hl+], a ; .px[0]
	ld a, d :: ld [hl+], a ; .px[1]
:

	call _ItemsUpdateCollision
	call ItemsUpdate
	call TangleUpdateAll

	call ScrollUpdate
	ld a, [wScroll.y + 0] :: ld [wSCY], a
	ld a, [wScroll.x + 0] :: ld [wSCX], a
	call MapUpdate
	call EntityRender

	; Pause game key input
	ldh a, [hKeysPressed]
	and PADF_START
	jr nz, _GotoPause

	ldh a, [hKeysPressed]
	and PADF_SELECT
	jr nz, _GotoPack

	ret


_GotoPause:
	call ModePush
	ld de, rModes_modePause
	jp ModeSetActive


_GotoPack:
	call ModePush
	ld de, rModes_modePack
	jp ModeSetActive


;; DEBUG: Map Flow Zone & Query
;; Sets player acceleration from flow vector if player entity is inside zone.
_TestMapZones:
	; Get map zone query result
	ld hl, wMapQueryResult.zone_rules
	ld a, [hl+] :: ld e, a
	ld a, [hl+] :: ld d, a
	; Only continue if rules pointer is less than $FF00 ~~ high byte below $FF
	inc a
	ret z

	; Get player entity
	ld a, [wPlayer.ent]
	call EntityAt
	ret nc

	; Set entity acceleration from flow vector
		wrambpush bank(wMapState)
	; check type ...
	ld a, [de] :: inc de
	cp MapEntityType_FLOW
	jr nz, :+
	; Flow Zone
	inc de :: inc de :: inc de :: inc de ; skip timer, flow_def, iseq
	; check type is flow and effect is enabled...
	ld a, [de] :: inc de
	and Effect_ENABLE | Effect_TYPE
	cp Effect_ENABLE | EffectType_FLOW
	jr nz, :+
	entity_index Entity_AccX
	ld a, [de] :: inc de ; flow.vx
	ld [hl+], a ; AccX
	entity_index Entity_AccY
	ld a, [de] :: inc de ; flow.vy
	ld [hl+], a ; AccY
:
		wrambpop ; wMapState

	ret


_ItemsUpdateCollision:
	; Use player position as Items collide point
	ld a, [wPlayer.ent]
	call EntityAt
	jr nc, .disable_item_collision

	ld a, [hl] ; .Info
	and ENTINFOF_INVIEW
	jr z, :+
	entity_index Entity_DispX
	ld a, [hl+] :: ld e, a
	ld a, [hl+] :: ld d, a
	ld a, 1
:
	jp ItemsSetCollidePoint
.disable_item_collision
	xor a
	jp ItemsSetCollidePoint


_ViewUpdate:
	; MapViewer overrides view following the target entity.
	ldh a, [hOptA]
	bit bOpt_MapViewer, a
	jp nz, MapViewerUpdate

	jp PlayerViewTarget

