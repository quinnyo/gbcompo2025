if !def(Q_MAP_INC_rJ398bhW)
def Q_MAP_INC_rJ398bhW equ 1

include "st.rgbinc"


rsreset
;; Terminates the brushes array.
def BR_TERM rb 1

;; { BR_SOLID, reps: db, value: db }
;; Emit `value` `reps+1` times.
def BR_SOLID rb 1

def BR__MAX rb 0
def BR__TYPE equ (1 << bitwidth(BR__MAX)) - 1

rsreset
def MapHeader_chunk_table rb 2
def MapHeader_objects rb 2
def szMapHeader rb 0


rsreset
def MapObject_typeid rb 2
def MapObject_y rb 2
def MapObject_x rb 2
def szMapObject rb 0


rsreset
;; Start of Item ID range
def MapObject_ITEM_ID rb 64
;; End of Item ID range
def MapObject_ITEM_ID_MAX rb 0
def MapObject_PLAYER_START rb 1
;; Flow zone rules
def MapObject_FLOW_RULES rb 1
def MapObject_NULL equ $FF


st FlowRules
	stf vx, 1
	stf vy, 1
st


def PLAYER_START_DEFAULT_Y equ 8 * 6
def PLAYER_START_DEFAULT_X equ 8 * 4


;; Metadata at the top of each Map chunk.
;; Provides pointers for navigating various chunk data.
st MapChunkHeader
	stf brushes0, 2
	stf brushes1, 2
	stf elements, 2
st


;; Start address of map runtime state section.
def MAP_RUNTIME_STATE_ADDRESS equ $D000
;; Size of map runtime state section.
def MAP_RUNTIME_STATE_SIZE equ $400


endc ; Q_MAP_INC_rJ398bhW

