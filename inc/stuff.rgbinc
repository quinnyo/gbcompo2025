if !def(STUFF_INC_D8F7D3C1)
def STUFF_INC_D8F7D3C1 equ 1

include "hardware.inc"

if def(BUILD_RAMSIZE)
	if BUILD_RAMSIZE >= 2 && BUILD_RAMSIZE <= 4
		def RAM_KBITS equ 16 << (BUILD_RAMSIZE - 1) * 2
	endc
endc

if def(BUILD_ROMSIZE)
	def ROM_KBYTES equ 256 << BUILD_ROMSIZE
else
	def ROM_KBYTES equ 256
endc

;; Number of 16 KiB ROM banks for the ROM size.
;; NOTE: Total bank count includes bank 0.
def ROMB_COUNT equ ROM_KBYTES >> 4


;; vblank_wait
;; Spin until either one is true:
;; - the LCD is off
;; - VBlank (specifically: `144 <= [rLY] < 153`)
;; @mut: A
macro vblank_wait
	; create a global label if there is none
	if !def(.)
		_vblank_wait\@:
	endc

.wait\@:
	; check that LCD is on -- avoid infinite loop if not
	ldh a, [rLCDC]
	bit LCDCB_ON, a
	jr z, .done\@

	; check 144 <= [LY] < 153
	ldh a, [rLY]
	cp 153
	jr nc, .wait\@ ; at end of VBlank, wait for next
	cp 144
	jr c, .wait\@
.done\@:
endm


macro dw_rgb555
	assert _NARG % 3 == 0
rept _NARG / 3
	assert (\1) >= 0 && (\1) < $20
	assert (\2) >= 0 && (\2) < $20
	assert (\3) >= 0 && (\3) < $20
	dw (\1) | ((\2) << 5) | ((\3) << 10)
	shift 3
endr
endm


endc ; STUFF_INC_D8F7D3C1

